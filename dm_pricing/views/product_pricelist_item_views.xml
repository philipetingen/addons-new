<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Extend Pricelist Item Form to show DM fields -->
    <record id="product_pricelist_item_form_view_dm" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.dm</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            
            <!-- Add DM Package Pricing section -->
            <xpath expr="//group[@name='pricelist_rule_computation']" position="after">
                
                <group string="DonnaMello Package Pricing" 
                       name="dm_package_pricing"
                       invisible="dm_is_package_price == False">
                    
                    <field name="dm_is_package_price" invisible="1"/>
                    
                    <group>
                        <field name="dm_packaging_id" 
                               required="dm_is_package_price == True"/>
                        <field name="dm_package_price" 
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               required="dm_is_package_price == True"/>
                        <field name="dm_unit_price_computed" 
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               readonly="1"/>
                    </group>
                    
                    <group>
                        <field name="dm_price_per_kg" 
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               readonly="1"/>
                        <field name="dm_moq_packages"/>
                        <field name="dm_moq_enforcement"/>
                    </group>
                    
                </group>
                
                <!-- Customer codes -->
                <group string="Customer Information" 
                       name="dm_customer_info"
                       invisible="dm_customer_product_code == False and dm_customer_description == False">
                    <field name="dm_customer_product_code"/>
                    <field name="dm_customer_description"/>
                </group>
                
                <!-- Sync info -->
                <group string="Sync Information" 
                       name="dm_sync_info"
                       invisible="dm_customer_pricelist_id == False">
                    <field name="dm_customer_pricelist_id" readonly="1"/>
                </group>
                
            </xpath>
            
            <!-- Add toggle to main form -->
            <xpath expr="//field[@name='compute_price']" position="before">
                <field name="dm_is_package_price" 
                       string="Use DM Package Pricing"
                       widget="boolean_toggle"/>
            </xpath>
            
        </field>
    </record>
    
    <!-- Extend Pricelist Item Tree -->
	<record id="product_pricelist_item_tree_view_dm" model="ir.ui.view">
		<field name="name">product.pricelist.item.tree.dm</field>
		<field name="model">product.pricelist.item</field>
		<field name="priority">20</field>
		<field name="arch" type="xml">
			<tree>
				<field name="pricelist_id" column_invisible="1"/>
				<field name="product_tmpl_id"/>
				<field name="product_id" optional="show"/>
				<field name="min_quantity"/>
				<field name="dm_is_package_price" optional="show" widget="boolean_toggle"/>
				<field name="dm_packaging_id" optional="show" invisible="dm_is_package_price == False"/>
				<field name="dm_package_price" optional="show" invisible="dm_is_package_price == False"/>
				<field name="fixed_price" optional="show" invisible="dm_is_package_price == True"/>
				<field name="date_start" optional="hide"/>
				<field name="date_end" optional="hide"/>
				<field name="company_id" groups="base.group_multi_company" optional="show"/>
			</tree>
		</field>
	</record>
    
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Customer Pricing Action -->
        <record id="action_dm_customer_pricelist" model="ir.actions.act_window">
            <field name="name">Customer Pricing</field>
            <field name="res_model">dm.customer.pricelist</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define customer-specific pricing
                </p>
                <p>
                    Set package-based prices with 6-decimal precision for each customer-product combination.
                    Prices automatically sync to Odoo pricelists.
                </p>
            </field>
        </record>
        
        <!-- Vendor Pricing Action (links to standard supplier info) -->
        <record id="action_dm_vendor_pricing" model="ir.actions.act_window">
            <field name="name">Vendor Pricing</field>
            <field name="res_model">product.supplierinfo</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_dm_is_package_price': 1}</field>
            <field name="domain">[('dm_is_package_price', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure vendor pricing and capacity
                </p>
                <p>
                    Manage package-based vendor prices, lead times, and production capacity.
                    Uses standard Odoo supplier info extended with DM fields.
                </p>
            </field>
        </record>
        
        <!-- Pricing Submenu -->
        <menuitem id="menu_dm_pricing" 
                  name="Pricing" 
                  parent="dm_master_data.menu_dm_configuration"
                  sequence="18"/>
        
        <menuitem id="menu_dm_customer_pricelist" 
                  name="Customer Prices" 
                  parent="menu_dm_pricing"
                  action="action_dm_customer_pricelist"
                  sequence="10"/>
        
        <menuitem id="menu_dm_vendor_pricelist" 
                  name="Vendor Prices" 
                  parent="menu_dm_pricing"
                  action="action_dm_vendor_pricing"
                  sequence="20"/>
        
    </data>
</odoo>
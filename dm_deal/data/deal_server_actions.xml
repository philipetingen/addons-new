<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    ========================================================================
    DM Deal Server Actions - REFACTORED v2.3.1
    ========================================================================
    
    CLEAN ARCHITECTURE: Generic actions only.
    
    Production and Shipment allocation actions have been REMOVED.
    They will be provided by dm_production and dm_shipment modules.
    
    This file provides ONLY generic allocation management actions.
    ========================================================================
    -->
    
    <!-- Server Action: View Deal Allocations -->
    <record id="action_server_view_allocations" model="ir.actions.server">
        <field name="name">View Allocations</field>
        <field name="model_id" ref="dm_deal.model_dm_deal"/>
        <field name="binding_model_id" ref="dm_deal.model_dm_deal"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Deal Allocations',
        'res_model': 'dm.allocation',
        'view_mode': 'tree,form',
        'domain': [
            ('deal_id', 'in', records.ids)
        ],
        'context': {
            'search_default_active': 1,
        }
    }
        </field>
    </record>
    
    <!-- Server Action: Remove All Allocations (Generic) -->
    <record id="action_server_deallocate_all" model="ir.actions.server">
        <field name="name">Remove All Allocations</field>
        <field name="model_id" ref="dm_deal.model_dm_deal"/>
        <field name="binding_model_id" ref="dm_deal.model_dm_deal"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    # Find all active allocations for these deals
    allocations = env['dm.allocation'].search([
        ('deal_id', 'in', records.ids),
        ('state', '=', 'active')
    ])
    
    if allocations:
        # Cancel all allocations
        allocations.action_cancel()
        
        # Update deal states back to confirmed
        for deal in records:
            if deal.state in ['allocated', 'partial']:
                deal.write({'state': 'confirmed'})
    else:
        raise UserError('No active allocations found for selected deals.')
        </field>
    </record>
    
</odoo>
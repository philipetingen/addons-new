<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deal Line Form View (for popup editing) -->
    <record id="view_dm_deal_line_form" model="ir.ui.view">
        <field name="name">dm.deal.line.form</field>
        <field name="model">dm.deal.line</field>
        <field name="arch" type="xml">
            <form string="Deal Line">
                <sheet>
                    <!-- Hidden fields for conditions -->
                    <field name="deal_state" invisible="1"/>
                    
                    <group>
                        <group string="Product">
                            <field name="customer_product_code" placeholder="Customer code..."/>
                            <field name="product_id" required="1"/>
                            <field name="customer_product_description"/>
                            <field name="product_packaging_id" 
                                   domain="[('product_id', '=', product_id)]"
                                   required="1"/>
                            <field name="packaging_uom_id" readonly="1"/>
                        </group>
                        
                        <group string="Quantities">
                            <!-- Entry mode selector -->
                            <field name="entry_mode" widget="radio"/>
                            
                            <!-- Package entry (readonly when in kg mode) -->
                            <field name="quantity_packaging" 
                                   readonly="entry_mode == 'kg'"
                                   required="entry_mode == 'pkg'"/>
                            
                            <!-- Weight entry (readonly when in pkg mode) -->
                            <field name="weight" 
                                   readonly="entry_mode == 'pkg'"
                                   required="entry_mode == 'kg'"/>
                            
                            <!-- Computed reference values -->
                            <field name="quantity_units" 
                                   readonly="1"
                                   string="≈ Units"/>
                        </group>
                    </group>
                    
                    <group string="Pricing">
                        <group string="Sales">
                            <field name="price_packaging_sale" widget="monetary"/>
                            <field name="price_unit_sale" readonly="1" widget="monetary"/>
                            <field name="price_per_kg_sale" readonly="1" widget="monetary"/>
                            <field name="amount_sale" readonly="1" widget="monetary"/>
                        </group>
                        <group string="Purchase">
                            <field name="price_packaging_purchase" widget="monetary"/>
                            <field name="price_unit_purchase" readonly="1" widget="monetary"/>
                            <field name="price_per_kg_purchase" readonly="1" widget="monetary"/>
                            <field name="amount_purchase" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    
                    <group string="Margin">
                        <field name="margin_amount" readonly="1" widget="monetary"/>
                        <field name="margin_percentage" readonly="1" widget="percentage"/>
                    </group>
                    
                    <group string="Container Requirements">
                        <group>
                            <field name="container_type_id" readonly="1"/>
                            <label for="containers_required"/>
                            <div>
                                <field name="containers_required" class="oe_inline"/>
                                <field name="container_calculation_method" 
                                       class="oe_inline ml8" 
                                       widget="badge"
                                       decoration-info="container_calculation_method == 'packaging'"
                                       decoration-success="container_calculation_method == 'volume'"
                                       decoration-warning="container_calculation_method == 'weight'"
                                       decoration-muted="container_calculation_method == 'manual'"/>
                            </div>
                            <field name="container_teu" readonly="1"/>
                        </group>
                        <group>
                            <field name="container_calculation_warning" 
                                   invisible="container_calculation_warning == False"
                                   readonly="1"
                                   class="text-warning"/>
                        </group>
                    </group>
                    
                    <group string="Progress Tracking" invisible="deal_state == 'draft'">
                        <group>
                            <field name="quantity_produced" readonly="1"/>
                            <field name="quantity_loaded" readonly="1"/>
                            <field name="quantity_invoiced" readonly="1"/>
                        </group>
                        <group>
                            <field name="production_progress" widget="progressbar"/>
                            <field name="sale_order_line_id" readonly="1"/>
                            <field name="purchase_order_line_id" readonly="1"/>
                        </group>
                    </group>
                    
                    <field name="notes" placeholder="Additional notes..." colspan="2"/>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Deal Line Tree View (for inline editing in deal form) -->
	<record id="view_dm_deal_line_tree" model="ir.ui.view">
		<field name="name">dm.deal.line.tree</field>
		<field name="model">dm.deal.line</field>
		<field name="arch" type="xml">
			<tree string="Deal Lines" 
				  editable="bottom"
				  decoration-success="production_progress == 100"
				  decoration-warning="production_progress &gt; 0 and production_progress &lt; 100">
				
				<!-- Hidden fields for conditions -->
				<field name="entry_mode" invisible="1"/>
				<field name="deal_id" invisible="1"/>
				<field name="deal_state" invisible="1"/>
				<field name="packaging_uom_id" invisible="1"/>
				
				<field name="sequence" widget="handle" width="30px"/>
				
				<!-- Customer code first for quick entry -->
				<field name="customer_product_code" placeholder="Customer code..." width="120px"/>
				
				<field name="product_id" required="1" width="200px"/>
				<field name="product_packaging_id" 
					   domain="[('product_id', '=', product_id)]"
					   required="1"
					   width="120px"/>
				
				<!-- ADD SUPPLIER HERE -->
				<field name="supplier_id" optional="show" width="150px"/>
				
				<!-- Entry mode toggle -->
				<field name="entry_mode" widget="radio" width="80px"/>
				
				<!-- Package quantity -->
				<field name="quantity_packaging" 
					   readonly="entry_mode == 'kg'"
					   required="entry_mode == 'pkg'"
					   force_save="1"
					   sum="Total"
					   width="100px"/>
				
				<!-- Weight -->
				<field name="weight" 
					   readonly="entry_mode == 'pkg'"
					   required="entry_mode == 'kg'"
					   force_save="1"
					   sum="Total Weight"
					   width="100px"/>
				
				<!-- Reference fields -->
				<field name="quantity_units" optional="hide" readonly="1" sum="Total Units" width="80px"/>
				
				<!-- Pricing -->
				<field name="price_packaging_sale" 
					   widget="monetary"
					   required="1"
					   width="120px"/>
					   
				<field name="price_per_kg_sale" 
					   readonly="1"
					   widget="monetary"
					   optional="show"
					   width="100px"/>
					   
				<field name="amount_sale" 
					   readonly="1" 
					   widget="monetary"
					   sum="Total"
					   width="120px"/>
				
				<field name="price_packaging_purchase" 
					   widget="monetary"
					   optional="show"
					   width="120px"/>
					   
				<field name="amount_purchase" 
					   readonly="1" 
					   widget="monetary"
					   optional="show"
					   sum="Total"
					   width="120px"/>
				
				<field name="margin_percentage" 
					   readonly="1" 
					   widget="percentage"
					   optional="show"
					   width="80px"/>
				
				<!-- Container calculations -->
				<field name="containers_required" 
					   optional="show"
					   sum="Total"
					   width="90px"/>
				
				<field name="container_calculation_method" 
					   optional="hide"
					   widget="badge"
					   decoration-info="container_calculation_method == 'packaging'"
					   decoration-success="container_calculation_method == 'volume'"
					   decoration-warning="container_calculation_method == 'weight'"
					   decoration-muted="container_calculation_method == 'manual'"
					   width="90px"/>
				
				<field name="container_teu"
					   optional="show"
					   readonly="1"
					   sum="Total TEU"
					   width="80px"/>
				
				<field name="container_type_id" optional="show" width="100px"/>
				<field name="production_progress" widget="progressbar" optional="show" width="100px"/>
				
				<!-- Customer description (optional) -->
				<field name="customer_product_description" optional="hide" width="150px"/>
			</tree>
		</field>
	</record>
</odoo>
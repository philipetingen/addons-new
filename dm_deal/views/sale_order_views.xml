<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Sale Order Form: Show DM fields -->
    <record id="view_order_form_dm_fields" model="ir.ui.view">
        <field name="name">sale.order.form.dm.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Hidden field for visibility condition -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="is_dm_order" invisible="1"/>
            </xpath>
            
            <!-- Add DM Deal reference in header -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="dm_deal_id" readonly="1" 
                       invisible="not dm_deal_id"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            
            <!-- Add package-native columns to inline order line tree -->
            <xpath expr="//field[@name='order_line']/tree//field[@name='qty_delivered']" position="after">
                <field name="qty_delivered_packages" string="Delivered (Pkg)" 
                       readonly="1"
                       optional="show"/>
                <field name="packaging_qty_dm" string="Ordered (Pkg)" 
                       readonly="1"
                       optional="show"/>
                <field name="packaging_price_unit" string="Pkg Price" 
                       readonly="1"
                       optional="hide"/>
                <field name="amount_package_native" string="Pkg Amount" 
                       readonly="1"
                       optional="hide"/>
                <field name="is_dm_line" column_invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
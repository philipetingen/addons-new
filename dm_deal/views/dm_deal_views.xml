<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ========================================================================
         TREE VIEW
         ======================================================================== -->
    
    <record id="view_dm_deal_tree" model="ir.ui.view">
        <field name="name">dm.deal.tree</field>
        <field name="model">dm.deal</field>
        <field name="arch" type="xml">
            <tree string="Deals" 
                  decoration-info="state == 'draft'"
                  decoration-primary="state == 'validated'"
                  decoration-warning="state in ['confirmed', 'partial']"
                  decoration-success="state in ['allocated', 'ready']"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_id"/>
				<field name="product_ids" widget="many2many_tags"/>
                <field name="customer_po_number"/>
                <field name="po_date"/>
                <field name="rts_current" optional="show"/>
                <field name="eta_current" optional="show"/>
                <field name="total_sale_amount" sum="Total" optional="show"/>
                <field name="margin_percentage" optional="show"/>
                <field name="total_containers" optional="show" sum="Total"/>
                <field name="total_teu" optional="show" sum="Total TEU"/>
                <field name="allocation_status" widget="badge" optional="show"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'validated'"
                       decoration-warning="state in ['confirmed', 'partial']"
                       decoration-success="state in ['allocated', 'ready', 'delivered', 'paid']"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>
    
    
    <!-- ========================================================================
         FORM VIEW
         ======================================================================== -->
    
    <record id="view_dm_deal_form" model="ir.ui.view">
        <field name="name">dm.deal.form</field>
        <field name="model">dm.deal</field>
        <field name="arch" type="xml">
            <form string="Deal">
                <header>
                    <!-- Hidden fields for conditions (MUST be in header or sheet) -->
                    <field name="state" invisible="1"/>
                    <field name="template_selection_pending" invisible="1"/>
                    <field name="so_confirmed" invisible="1"/>
                    <field name="po_confirmed" invisible="1"/>
                    
                    <!-- Status bar -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,confirmed,allocated,ready,shipping,delivered"/>
                    
                    <!-- State transition buttons (Phase 4B Step 1) -->
                    <button name="action_validate" 
                            string="Validate" 
                            type="object" 
                            invisible="state != 'draft'" 
                            class="btn-primary"
                            help="Validate deal data completeness - does NOT create SO/PO yet"/>
                    
                    <button name="action_confirm" 
                            string="Confirm Deal" 
                            type="object" 
                            invisible="state != 'validated'" 
                            class="btn-primary"
                            confirm="This will create and confirm SO/PO. The deal will be committed and lines/prices will be locked. Continue?"
                            help="Commitment point - creates and confirms SO/PO, locks deal data"/>
                    
                    <!-- Template selection button (when pending) -->
                    <button name="action_select_template" 
                            string="Select Template" 
                            type="object" 
                            invisible="not template_selection_pending"
                            class="btn-warning"
                            icon="fa-warning"
                            help="Multiple templates match this deal - click to select one"/>
                    
                    <!-- Cancel button -->
                    <button name="action_cancel" 
                            string="Cancel" 
                            type="object" 
                            invisible="state in ['cancelled', 'delivered', 'completed']"
                            confirm="Are you sure you want to cancel this deal?"/>
                </header>
                
                <!-- ============================================================ -->
                <!-- LOCK WARNING BANNERS -->
                <!-- ============================================================ -->
                
                <!-- Production Lock Warning -->
                <div class="alert alert-warning" 
                     role="alert"
                     invisible="not is_locked_for_production"
                     style="margin-bottom: 0;">
                    <i class="fa fa-lock"/> 
                    <strong>Production Lock:</strong>
                    This deal is locked by <field name="production_lock_reason" readonly="1" class="fw-bold"/>.
                    Production-critical fields cannot be modified.
                    <button name="action_unlock_production" 
                            type="object" 
                            string="Unlock (Cancel Allocation)" 
                            class="btn-link"
                            confirm="This will cancel the production allocation and return the deal to 'confirmed' state. Continue?"/>
                </div>
                
                <!-- Shipment Lock Warning -->
                <div class="alert alert-info" 
                     role="alert"
                     invisible="not is_locked_for_shipment"
                     style="margin-bottom: 0;">
                    <i class="fa fa-ship"/> 
                    <strong>Shipment Lock:</strong>
                    This deal is locked by <field name="shipment_lock_reason" readonly="1" class="fw-bold"/>.
                    Logistics fields cannot be modified.
                    <button name="action_unlock_shipment" 
                            type="object"
                            string="Unlock (Cancel Allocation)"
                            class="btn-link"
                            confirm="This will cancel the shipment allocation. Continue?"/>
                </div>
                
                <sheet>
                    <!-- Hidden fields for lock checks (Phase 4B Step 1) -->
                    <field name="is_locked_for_production" invisible="1"/>
                    <field name="is_locked_for_shipment" invisible="1"/>
                    <field name="lines_readonly" invisible="1"/>
                    <field name="prices_readonly" invisible="1"/>
                    <field name="customer_readonly" invisible="1"/>
                    <field name="vendor_readonly" invisible="1"/>
                    <field name="dates_readonly" invisible="1"/>
                
                    <!-- Template Selection Pending Alert -->
                    <div class="alert alert-warning" 
                         role="alert" 
                         invisible="not template_selection_pending"
                         style="margin-bottom: 15px;">
                        <strong>⚠️ Action Required:</strong> Multiple deal templates match this product. Please select the appropriate template.
                        <button name="action_select_template" 
                                string="Select Template Now" 
                                type="object" 
                                class="btn-primary btn-sm" 
                                style="margin-left: 10px;"/>
                    </div>

                    <!-- Hidden fields for conditions -->
                    <field name="invoice_split" invisible="1"/>
                    <field name="allocation_status" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    
                    <!-- Document Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <!-- Sales Orders -->
                        <button name="action_view_sale_orders" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-shopping-cart" 
                                invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Sales Orders"/>
                        </button>
                        
                        <!-- Purchase Orders -->
                        <button name="action_view_purchase_orders" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-shopping-bag" 
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                        
                        <!-- Allocations -->
                        <button name="action_view_allocations" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-link" 
                                invisible="allocation_count == 0">
                            <field name="allocation_count" widget="statinfo" string="Allocations"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <!-- ============================================================ -->
                    <!-- MAIN FORM CONTENT -->
                    <!-- ============================================================ -->
                    
                    <group name="main">
                        <group name="deal_info" string="Deal Information">
                            <field name="customer_id" 
                                   readonly="customer_readonly"
                                   required="1"/>
                            <field name="customer_po_number" 
                                   readonly="customer_readonly"
                                   required="1"/>
                            <field name="po_date"/>
                            <field name="validation_date" readonly="1"/>
                            <field name="confirmation_date" readonly="1"/>
                        </group>
                        
                        <group name="commercial_info" string="Commercial Info">
                            <field name="supplier_id" 
                                   readonly="vendor_readonly"/>
                            <field name="incoterm_id"/>
                            <field name="sale_incoterm_id"/>
                            <field name="purchase_incoterm_id"/>
                        </group>
                    </group>
                    
                    <group name="logistics">
                        <group name="ports" string="Logistics">
                            <field name="loading_port_id"/>
                            <field name="discharge_port_id"/>
                        </group>
                        
                        <group name="key_dates" string="Key Dates">
                            <field name="rts_requested" 
                                   readonly="dates_readonly"
                                   string="RTS (Requested)"/>
                            <field name="rts_current" 
                                   readonly="1"
                                   string="RTS (Current)"/>
                            <field name="eta_requested" 
                                   readonly="dates_readonly"
                                   string="ETA (Requested)"/>
                            <field name="eta_current" 
                                   readonly="1"
                                   string="ETA (Current)"/>
                        </group>
                    </group>
                    
                    <!-- QUANTITY SUMMARY (Phase 4B Step 2) -->
                    <group name="quantity_summary" string="Quantity Summary">
                        <group>
                            <field name="total_quantity_ordered" string="Total Ordered (Packages)"/>
                            <field name="total_quantity_produced" string="Total Produced (Packages)"/>
                        </group>
                        <group>
                            <field name="total_quantity_loaded" string="Total Loaded (Packages)"/>
                            <field name="quantity_completion_rate" widget="percentage"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Products Tab - THREE-QUANTITY COLUMNS (Phase 4B Step 2) -->
                        <page string="Products" name="products">
                            <field name="line_ids" 
                                   widget="one2many" 
                                   readonly="lines_readonly"
                                   context="{'default_deal_id': active_id}">
                                <tree editable="bottom"
                                      decoration-warning="production_status == 'variance' or loading_status == 'variance'"
                                      decoration-muted="deal_state == 'cancelled'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" 
                                           readonly="parent.lines_readonly"
                                           required="1"
                                           domain="[('sale_ok', '=', True)]"/>
                                    <field name="product_packaging_id" 
                                           readonly="parent.lines_readonly"
                                           required="1"
                                           domain="[('product_id', '=', product_id)]"/>
                                    
                                    <!-- THREE-QUANTITY DISPLAY (Phase 4B Step 2) -->
                                    <field name="quantity_packaging" 
                                           readonly="parent.lines_readonly"
                                           string="Ordered"
                                           sum="Total Ordered"/>
                                    
                                    <field name="quantity_produced" 
                                           string="Produced" 
                                           readonly="1"
                                           optional="show"
                                           sum="Total Produced"/>
                                    
                                    <field name="quantity_loaded" 
                                           string="Loaded" 
                                           readonly="1"
                                           optional="show"
                                           sum="Total Loaded"/>
                                    
                                    <!-- VARIANCE COLUMNS (optional, hidden by default) -->
                                    <field name="quantity_variance_production" 
                                           string="Prod. Var." 
                                           readonly="1"
                                           optional="hide"
                                           decoration-danger="quantity_variance_production &lt; 0"
                                           decoration-success="quantity_variance_production &gt; 0"/>
                                    
                                    <field name="quantity_variance_loading" 
                                           string="Load Var." 
                                           readonly="1"
                                           optional="hide"
                                           decoration-danger="quantity_variance_loading &lt; 0"
                                           decoration-success="quantity_variance_loading &gt; 0"/>
                                    
                                    <!-- STATUS INDICATORS (hidden, for decoration conditions) -->
                                    <field name="production_status" invisible="1"/>
                                    <field name="loading_status" invisible="1"/>
                                    
                                    <field name="packaging_uom_id" 
                                           readonly="1"
                                           string="Package UoM"
                                           optional="hide"/>
                                    <field name="quantity_units" 
                                           readonly="1"
                                           string="Qty (Units)"
                                           optional="hide"/>
                                    <field name="price_packaging_sale" 
                                           readonly="parent.prices_readonly"
                                           widget="monetary"
                                           string="Sale Price/Pkg"/>
                                    <field name="price_packaging_purchase" 
                                           readonly="parent.prices_readonly"
                                           widget="monetary"
                                           string="Purchase Price/Pkg"
                                           optional="hide"/>
                                    <field name="amount_sale" 
                                           readonly="1"
                                           widget="monetary"
                                           sum="Total Sale"/>
                                    <field name="amount_purchase" 
                                           readonly="1"
                                           widget="monetary"
                                           sum="Total Purchase"
                                           optional="hide"/>
                                    <field name="margin_amount" 
                                           readonly="1"
                                           widget="monetary"
                                           string="Margin"
                                           sum="Total Margin"/>
                                    <field name="margin_percentage" 
                                           readonly="1"
                                           string="Margin %"/>
                                    <field name="container_type_id" 
                                           readonly="1"
                                           string="Container"
                                           optional="hide"/>
                                    
                                    <!-- HIDDEN FIELDS FOR CONDITIONS -->
                                    <field name="deal_state" invisible="1"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            
                            <!-- Deal Totals -->
                            <group name="totals" class="oe_subtotal_footer oe_right">
                                <field name="total_sale_amount" 
                                       widget="monetary" 
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="total_purchase_amount" 
                                       widget="monetary" 
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="margin_amount" 
									   string="Total Margin"
									   widget="monetary" 
									   options="{'currency_field': 'currency_id'}"
									   class="oe_subtotal_footer_separator"/>
                                <field name="margin_percentage" string="Margin %"/>
                            </group>
                        </page>
                        
                        <!-- Payment Terms Tab -->
                        <page string="Payment Terms">
                            <group>
                                <group string="Sales">
                                    <field name="sale_payment_term_id"/>
                                </group>
                                <group string="Purchase">
                                    <field name="purchase_payment_term_id"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Container Summary Tab -->
                        <page string="Container Summary">
                            <group>
                                <field name="total_containers" readonly="1"/>
                                <field name="total_teu" readonly="1"/>
                                <field name="container_summary" readonly="1" nolabel="1"/>
                            </group>
                        </page>
                        
                        <!-- Milestones Tab -->
                        <page string="Milestones">
                            
                            <separator string="Milestone 2: Production Start"/>
                            <group col="4">
                                <label for="production_start_requested" string="Prod. Start"/>
                                <field name="production_start_requested" 
                                       readonly="dates_readonly"
                                       placeholder="Requested..."/>
                                <field name="production_start_current" placeholder="Current..."/>
                                <field name="production_start_actual" 
                                       readonly="1" 
                                       placeholder="Actual..."
                                       decoration-success="production_start_actual"/>
                            </group>
                            
                            <separator string="Milestone 3: Ready to Ship (RTS)"/>
                            <group col="4">
                                <label for="rts_requested" string="RTS"/>
                                <field name="rts_requested" 
                                       readonly="dates_readonly"
                                       placeholder="Requested..."/>
                                <field name="rts_current" placeholder="Current..."/>
                                <field name="rts_actual" 
                                       readonly="1" 
                                       placeholder="Actual..."
                                       decoration-success="rts_actual"/>
                            </group>
                            
                            <separator string="Milestone 4: Loading"/>
                            <group col="4">
                                <label for="loading_requested" string="Loading"/>
                                <field name="loading_requested" 
                                       readonly="dates_readonly"
                                       placeholder="Requested..."/>
                                <field name="loading_current" placeholder="Current..."/>
                                <field name="loading_actual" 
                                       readonly="1" 
                                       placeholder="Actual..."
                                       decoration-success="loading_actual"/>
                            </group>
                            
                            <separator string="Milestone 5: Vessel Departure (ETD)"/>
                            <group col="4">
                                <label for="etd_requested" string="ETD"/>
                                <field name="etd_requested" 
                                       readonly="dates_readonly"
                                       placeholder="Requested..."/>
                                <field name="etd_current" placeholder="Current..."/>
                                <field name="etd_actual" 
                                       readonly="1" 
                                       placeholder="Actual..."
                                       decoration-success="etd_actual"/>
                            </group>
                            
                            <separator string="Milestone 6: Port Arrival (ETA)"/>
                            <group col="4">
                                <label for="eta_requested" string="ETA"/>
                                <field name="eta_requested" 
                                       readonly="dates_readonly"
                                       placeholder="Requested..."/>
                                <field name="eta_current" placeholder="Current..."/>
                                <field name="eta_actual" 
                                       readonly="1" 
                                       placeholder="Actual..."
                                       decoration-success="eta_actual"/>
                            </group>
                            
                            <separator string="Milestone 7: Final Delivery"/>
                            <group col="4">
                                <label for="delivery_requested" string="Delivery"/>
                                <field name="delivery_requested" 
                                       readonly="dates_readonly"
                                       placeholder="Requested..."/>
                                <field name="delivery_current" placeholder="Current..."/>
                                <field name="delivery_actual" 
                                       readonly="1" 
                                       placeholder="Actual..."
                                       decoration-success="delivery_actual"/>
                            </group>
                            
                            <group>
                                <div class="alert alert-warning" role="alert" invisible="state in ['draft', 'validated']">
                                    <p class="mb-0">
                                        <strong>⚠️ Note:</strong> Actual dates are set automatically by production and shipment modules.
                                        Do not edit these manually unless correcting an error.
                                    </p>
                                </div>
                            </group>
                        </page>
                        
                        <!-- Template Tab -->
                        <page string="Template" invisible="state != 'draft'">
                            <group>
                                <field name="template_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    
    <!-- ========================================================================
         SEARCH VIEW
         ======================================================================== -->
    
    <record id="view_dm_deal_search" model="ir.ui.view">
        <field name="name">dm.deal.search</field>
        <field name="model">dm.deal</field>
        <field name="arch" type="xml">
            <search string="Search Deals">
                <field name="name"/>
                <field name="customer_id" operator="child_of"/>
                <field name="customer_po_number"/>
                <field name="supplier_id" operator="child_of"/>
                
                <!-- State Filters -->
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="allocated" string="Allocated" domain="[('state', '=', 'allocated')]"/>
                <filter name="ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                
                <separator/>
                
                <!-- Allocation Filters -->
                <filter name="unallocated" string="Not Allocated" domain="[('allocation_status', '=', 'unallocated')]"/>
                <filter name="partial_alloc" string="Partially Allocated" domain="[('allocation_status', '=', 'partial')]"/>
                <filter name="full_alloc" string="Fully Allocated" domain="[('allocation_status', '=', 'allocated')]"/>
                
                <separator/>
                
                <!-- Status Filters -->
                <filter name="awaiting_confirmation" string="⏳ Awaiting Confirmation" 
                        domain="[('state', '=', 'validated')]"/>
                
                <separator/>
                
                <!-- Date Filters -->
                <filter name="this_month" string="This Month" 
                        domain="[('po_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                
                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    <filter name="group_by_supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_allocation" string="Allocation" context="{'group_by': 'allocation_status'}"/>
                    <filter name="group_by_month" string="PO Month" context="{'group_by': 'po_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    
    
    <!-- ========================================================================
         ACTION
         ======================================================================== -->
    
    <record id="action_dm_deal" model="ir.actions.act_window">
        <field name="name">Deals</field>
        <field name="res_model">dm.deal</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_draft': 1, 'search_default_validated': 1, 'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first deal
            </p>
            <p>
                Deals manage the entire flow from customer PO to delivery, including production and shipment allocation.
            </p>
        </field>
    </record>
    
</odoo>
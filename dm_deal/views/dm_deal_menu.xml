<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ========================================================================
         DEAL MANAGEMENT MENU STRUCTURE
         ======================================================================== -->
    
    <!-- Root Menu -->
    <menuitem id="menu_dm_deal_root"
              name="Deals"
              sequence="10"
              web_icon="dm_deal,static/description/icon.png"/>
    
    <!-- Operations Section -->
    <menuitem id="menu_dm_deal_operations"
              name="Operations"
              parent="menu_dm_deal_root"
              sequence="10"/>
    
    <!-- Deals Menu Item (opens tree view with standard New button) -->
    <menuitem id="menu_dm_deal"
              name="Deals"
              parent="menu_dm_deal_operations"
              action="action_dm_deal"
              sequence="10"/>
    
    <!-- Create Deal via Wizard (separate menu item for guided workflow) -->
    <menuitem id="menu_dm_deal_create_wizard"
              name="Create Deal (Wizard)"
              parent="menu_dm_deal_operations"
              action="action_deal_creation_wizard"
              sequence="20"/>
    
    <!-- Configuration Section -->
    <menuitem id="menu_dm_deal_configuration"
              name="Configuration"
              parent="menu_dm_deal_root"
              sequence="90"/>
    
    <!-- Deal Templates Menu Item -->
    <menuitem id="menu_dm_deal_template"
              name="Deal Templates"
              parent="menu_dm_deal_configuration"
              action="action_dm_deal_template"
              sequence="10"/>
    
</odoo>
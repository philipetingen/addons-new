<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    ========================================================================
    DM DEAL ALLOCATION VIEWS - REFACTORED v2.3.0
    ========================================================================
    
    CLEAN ARCHITECTURE: Minimal allocation infrastructure only.
    
    Production and Shipment specific UI elements are NOW PROVIDED BY:
    - dm_production module (production smart buttons, allocation wizards)
    - dm_shipment module (shipment smart buttons, allocation wizards)
    
    This file provides ONLY the generic allocation infrastructure.
    ========================================================================
    -->
    
    <!-- ========================================================================
         DEAL FORM VIEW - GENERIC ALLOCATION TAB
         ======================================================================== -->
    
    <record id="view_dm_deal_form_allocation" model="ir.ui.view">
        <field name="name">dm.deal.form.allocation</field>
        <field name="model">dm.deal</field>
        <field name="inherit_id" ref="dm_deal.view_dm_deal_form"/>
        <field name="arch" type="xml">
            
            <!-- Add Generic Allocations Smart Button -->
            <div name="button_box" position="inside">
                <button name="action_view_allocations" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-link"
                        invisible="allocation_count == 0">
                    <field name="allocation_count" widget="statinfo" string="Allocations"/>
                </button>
            </div>
            
            <!-- Add Generic Deallocation Action in Header -->
            <header position="inside">
                <button name="action_deallocate_all" 
                        string="Remove All Allocations" 
                        type="object" 
                        class="btn-secondary"
                        invisible="allocation_count == 0"
                        confirm="Are you sure you want to remove all allocations? This will cancel all active allocations."
                        help="Cancel all active allocations"/>
            </header>
            
            <!-- Add Generic Allocation Tab in Notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Allocations" name="allocations">
                    
                    <!-- Allocation Summary -->
                    <group>
                        <group string="Allocation Status">
                            <field name="allocation_status" readonly="1" widget="badge"/>
                            <field name="allocation_count" readonly="1"/>
                        </group>
                        <group string="Note">
                            <div class="alert alert-info">
                                <p>Allocation details will appear here when dm_production and dm_shipment modules are installed.</p>
                            </div>
                        </group>
                    </group>
                    
                    <separator string="Allocation History"/>
                    
                    <!-- Allocation Records Tree -->
                    <field name="allocation_ids" readonly="1">
                        <tree decoration-success="state == 'completed'" 
                              decoration-muted="state == 'cancelled'"
                              decoration-info="state == 'active'">
                            <field name="name"/>
                            <field name="allocation_type" widget="badge"/>
                            <field name="allocation_date" widget="datetime"/>
                            <field name="state" widget="badge" 
                                   decoration-success="state == 'completed'"
                                   decoration-warning="state == 'active'"
                                   decoration-muted="state == 'cancelled'"/>
                            <field name="completion_date" widget="datetime"/>
                            
                            <!-- Action Buttons -->
                            <button name="action_complete" 
                                    string="Complete" 
                                    type="object" 
                                    icon="fa-check-circle"
                                    invisible="state != 'active'"
                                    confirm="Mark this allocation as completed?"/>
                            <button name="action_cancel" 
                                    string="Cancel" 
                                    type="object" 
                                    icon="fa-times-circle"
                                    invisible="state not in ['draft', 'active']"
                                    confirm="Cancel this allocation? The deal will be freed for reallocation."/>
                        </tree>
                    </field>
                    
                    <!-- Help Text -->
                    <div class="alert alert-info" role="status" style="margin-top: 15px;">
                        <p><strong>About Allocations:</strong></p>
                        <ul>
                            <li><strong>Draft:</strong> Allocation created but not yet active</li>
                            <li><strong>Active:</strong> Deal is currently allocated to a workflow</li>
                            <li><strong>Completed:</strong> Workflow finished successfully</li>
                            <li><strong>Cancelled:</strong> Allocation removed, deal available again</li>
                        </ul>
                        <p style="margin-top: 10px;">
                            <em>Note: Install dm_production and dm_shipment modules to enable production and shipment allocation workflows.</em>
                        </p>
                    </div>
                    
                </page>
            </xpath>
            
        </field>
    </record>
    
    
    <!-- ========================================================================
         DEAL TREE VIEW - ALLOCATION STATUS COLUMN
         ======================================================================== -->
    
    <record id="view_dm_deal_tree_allocation" model="ir.ui.view">
        <field name="name">dm.deal.tree.allocation</field>
        <field name="model">dm.deal</field>
        <field name="inherit_id" ref="dm_deal.view_dm_deal_tree"/>
        <field name="arch" type="xml">
            
            <!-- Add allocation status column after state -->
            <field name="state" position="after">
                <field name="allocation_status" 
                       widget="badge" 
                       optional="show"
                       decoration-success="allocation_status == 'allocated'"
                       decoration-warning="allocation_status == 'partial'"
                       decoration-muted="allocation_status == 'unallocated'"/>
            </field>
            
        </field>
    </record>
    
    
    <!-- ========================================================================
         ALLOCATION MODEL VIEWS (standalone)
         ======================================================================== -->
    
    <!-- Allocation Tree View -->
    <record id="view_dm_allocation_tree" model="ir.ui.view">
        <field name="name">dm.allocation.tree</field>
        <field name="model">dm.allocation</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'completed'" 
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'active'"
                  create="0">
                <field name="name"/>
                <field name="deal_id"/>
                <field name="allocation_type" widget="badge"/>
                <field name="allocation_date" widget="datetime"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'active'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="completion_date" widget="datetime"/>
            </tree>
        </field>
    </record>
    
    <!-- Allocation Form View -->
    <record id="view_dm_allocation_form" model="ir.ui.view">
        <field name="name">dm.allocation.form</field>
        <field name="model">dm.allocation</field>
        <field name="arch" type="xml">
            <form string="Allocation" create="0">
                <header>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,active,completed"/>
                    <button name="action_activate" 
                            string="Activate" 
                            type="object" 
                            invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_complete" 
                            string="Complete" 
                            type="object" 
                            invisible="state != 'active'"
                            class="btn-primary"/>
                    <button name="action_cancel" 
                            string="Cancel" 
                            type="object" 
                            invisible="state in ['completed', 'cancelled']"
                            class="btn-secondary"
                            confirm="Cancel this allocation?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="deal_id" readonly="1"/>
                            <field name="allocation_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="allocation_date" readonly="1"/>
                            <field name="completion_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes about this allocation..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Allocation Search View -->
    <record id="view_dm_allocation_search" model="ir.ui.view">
        <field name="name">dm.allocation.search</field>
        <field name="model">dm.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="deal_id"/>
                <field name="allocation_type"/>
                <field name="state"/>
                
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                
                <separator/>
                
                <filter name="production" string="Production" domain="[('allocation_type', '=', 'production')]"/>
                <filter name="shipment" string="Shipment" domain="[('allocation_type', '=', 'shipment')]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'allocation_type'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_deal" string="Deal" context="{'group_by': 'deal_id'}"/>
                    <filter name="group_date" string="Allocation Date" context="{'group_by': 'allocation_date'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Allocation Action -->
    <record id="action_dm_allocation" model="ir.actions.act_window">
        <field name="name">Allocations</field>
        <field name="res_model">dm.allocation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No allocations found
            </p>
            <p>
                Allocations track which deals are assigned to production runs and shipments.
                They are created automatically by workflow modules.
            </p>
        </field>
    </record>
    
    <!-- Allocation Board Action (Kanban View) -->
    <record id="action_dm_deal_allocation_board" model="ir.actions.act_window">
        <field name="name">Allocation Board</field>
        <field name="res_model">dm.allocation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1, 'search_default_group_type': 1}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No allocations yet
            </p>
            <p>
                The Allocation Board shows all active allocations grouped by type.
                Install dm_production and dm_shipment modules to start allocating deals.
            </p>
        </field>
    </record>
    
</odoo>
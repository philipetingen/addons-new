<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Invoice/Bill Form: Show DM Deal reference in header only -->
    <record id="view_move_form_dm_fields" model="ir.ui.view">
        <field name="name">account.move.form.dm.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Add hidden field and DM Deal reference -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="is_dm_invoice" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="dm_deal_id" readonly="1" 
                       invisible="not dm_deal_id"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
    
    <!-- Account Move Line Tree: Package-native columns -->
    <record id="view_move_line_tree_dm_fields" model="ir.ui.view">
        <field name="name">account.move.line.tree.dm.fields</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="packaging_qty_dm" string="Pkg Qty" 
                       readonly="1"
                       optional="hide"/>
                <field name="packaging_price_unit" string="Pkg Price" 
                       readonly="1"
                       optional="hide"/>
                <field name="amount_package_native" string="Pkg Amount" 
                       readonly="1"
                       optional="hide"/>
                <field name="is_dm_line" column_invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category -->
    <record id="module_category_dm_deal" model="ir.module.category">
        <field name="name">DonnaMello Deal Management</field>
        <field name="description">Manage deals, templates, and commercial operations</field>
        <field name="sequence">10</field>
    </record>
    
    <!-- Groups -->
    <record id="group_dm_deal_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_dm_deal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view and create deals</field>
    </record>
    
    <record id="group_dm_deal_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_dm_deal"/>
        <field name="implied_ids" eval="[(4, ref('group_dm_deal_user'))]"/>
        <field name="comment">Can manage all deals and templates</field>
    </record>
</odoo>
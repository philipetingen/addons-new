<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Actions Only - No Menu Items -->
        <record id="action_packaging_standard_type" model="ir.actions.act_window">
            <field name="name">Packaging Standard Types</field>
            <field name="res_model">packaging.standard.type</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define Packaging Standard Types
                </p>
                <p>
                    Create standard packaging types like Unit, Inner, Case, Pallet, Container
                    to organize your packaging hierarchy.
                </p>
            </field>
        </record>
        
        <record id="action_product_packaging" model="ir.actions.act_window">
            <field name="name">Product Packaging</field>
            <field name="res_model">product.packaging</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_groupby_product': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Product Packaging
                </p>
                <p>
                    Define packaging hierarchy for your products with automatic UoM creation
                    and support for complex nested structures.
                </p>
            </field>
        </record>
        
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Extend Deal Form - Add Production Smart Button -->
    <record id="view_dm_deal_form_production" model="ir.ui.view">
        <field name="name">dm.deal.form.production</field>
        <field name="model">dm.deal</field>
        <field name="inherit_id" ref="dm_deal.view_dm_deal_form"/>
        <field name="arch" type="xml">
            
            <!-- Add hidden field for conditions -->
            <field name="allocation_status" position="after">
                <field name="production_allocated" invisible="1"/>
            </field>
            
            <!-- Add Production Smart Button -->
            <div name="button_box" position="inside">
                <button name="action_view_production_runs" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-industry"
                        invisible="production_count == 0">
                    <field name="production_count" widget="statinfo" string="Production"/>
                </button>
            </div>
            
            <!-- Add Allocate to Production Button -->
            <header position="inside">
                <button name="action_allocate_to_production" 
                        string="Allocate to Production" 
                        type="object" 
                        class="btn-primary"
                        invisible="state not in ['confirmed', 'allocated', 'ready'] or production_allocated == True"
                        help="Allocate this deal to a production run"/>
            </header>
            
        </field>
    </record>
    
</odoo>
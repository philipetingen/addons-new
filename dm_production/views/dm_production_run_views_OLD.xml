<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ================================================================== -->
    <!-- ENHANCED PRODUCTION RUN VIEWS - PHASE 3A                           -->
    <!-- ================================================================== -->
    
    <!-- Production Run Tree View - Enhanced with Capacity -->
    <record id="view_dm_production_run_tree" model="ir.ui.view">
        <field name="name">dm.production.run.tree</field>
        <field name="model">dm.production.run</field>
        <field name="arch" type="xml">
            <tree string="Production Runs"
                  decoration-success="capacity_status_color == 'green'"
                  decoration-warning="capacity_status_color == 'yellow'"
                  decoration-danger="capacity_status_color == 'red'">
                
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="rts_date"/>
                <field name="deal_count" string="Deals"/>
                
                <!-- Phase 3: TEU and Container columns -->
                <field name="total_teu" 
                       string="TEU" 
                       optional="show"
                       sum="Total TEU"
                       widget="float"
                       options="{'precision': 1}"/>
                
                <field name="total_containers" 
                       string="Containers" 
                       optional="hide"
                       sum="Total Containers"
                       widget="float"
                       options="{'precision': 1}"/>
                
                <field name="container_summary" 
                       string="Container Mix" 
                       optional="show"/>
                
                <!-- Phase 3A: Capacity Utilization -->
                <field name="capacity_utilization_pct" 
                       string="Utilization" 
                       widget="progressbar"
                       optional="show"/>
                
                <field name="capacity_status_color" column_invisible="1"/>
                
                <field name="state" widget="badge" 
                       decoration-success="state == 'done'"
                       decoration-info="state == 'production'"
                       decoration-warning="state == 'confirmed'"/>
            </tree>
        </field>
    </record>
    
    <!-- Production Run Form View - Enhanced -->
    <record id="view_dm_production_run_form" model="ir.ui.view">
        <field name="name">dm.production.run.form</field>
        <field name="model">dm.production.run</field>
        <field name="arch" type="xml">
            <form string="Production Run">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_start_production" string="Start Production" type="object"
                            invisible="state != 'confirmed'" class="btn-primary"/>
                    <button name="action_mark_ready" string="Mark Ready" type="object"
                            invisible="state != 'production'" class="btn-primary"/>
                    <button name="action_done" string="Done" type="object"
                            invisible="state != 'ready'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['done', 'cancelled']" class="btn-secondary"
                            confirm="Cancel this production run? Active allocations will be cancelled."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,production,ready,done"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_deals" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="deal_count == 0">
                            <field name="deal_count" widget="statinfo" string="Deals"/>
                        </button>
                        
                        <!-- Phase 3: TEU stat button -->
                        <button name="action_view_deals" 
                                type="object"
                                class="oe_stat_button" 
                                icon="fa-cube"
                                invisible="total_teu == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_teu" widget="float" options="{'precision': 1}"/>
                                </span>
                                <span class="o_stat_text">TEU</span>
                            </div>
                        </button>
                        
                        <!-- Phase 3: Containers stat button -->
                        <button name="action_view_deals" 
                                type="object"
                                class="oe_stat_button" 
                                icon="fa-archive"
                                invisible="total_containers == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_containers" widget="float" options="{'precision': 1}"/>
                                </span>
                                <span class="o_stat_text">Containers</span>
                            </div>
                        </button>
                        
                        <!-- Phase 3A: Capacity utilization stat button -->
                        <button name="%(dm_capacity_planning.action_dm_capacity_check_wizard)d" 
                                type="action"
                                class="oe_stat_button" 
                                icon="fa-tachometer"
                                invisible="capacity_utilization_pct == 0"
                                context="{'default_production_run_id': id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="capacity_utilization_pct" widget="float" options="{'precision': 0}"/>%
                                </span>
                                <span class="o_stat_text">Capacity</span>
                            </div>
                            <field name="capacity_status_color" invisible="1"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="supplier_id" readonly="state != 'draft'"/>
                            <field name="production_start_date"/>
                        </group>
                        <group>
                            <field name="rts_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <!-- Phase 3: Container summary -->
                            <field name="container_summary" 
                                   readonly="1"
                                   invisible="container_summary == False"
                                   string="Container Mix"/>
                        </group>
                    </group>
                    
                    <!-- Phase 3A: Capacity Overview Banner -->
                    <div class="alert alert-info" 
                         role="alert"
                         invisible="month_capacity_teu == 0">
                        <div class="row">
                            <div class="col-md-8">
                                <strong>Capacity Status:</strong>
                                <field name="total_teu" readonly="1" class="oe_inline"/> TEU allocated
                                of <field name="month_capacity_teu" readonly="1" class="oe_inline"/> TEU capacity
                                (<field name="capacity_utilization_pct" readonly="1" class="oe_inline"/>% utilized)
                            </div>
                            <div class="col-md-4">
                                <field name="capacity_utilization_pct" 
                                       widget="progressbar" 
                                       readonly="1"
                                       nolabel="1"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Warning/Error for capacity -->
                    <div class="alert alert-warning" 
                         role="alert"
                         invisible="capacity_status_color != 'yellow'">
                        <i class="fa fa-exclamation-triangle"/> 
                        <strong>Near Capacity Limit:</strong>
                        This production run is using <field name="capacity_utilization_pct" readonly="1" nolabel="1" class="oe_inline"/>% 
                        of vendor capacity. Consider splitting to avoid over-allocation.
                    </div>
                    
                    <div class="alert alert-danger" 
                         role="alert"
                         invisible="capacity_status_color != 'red'">
                        <i class="fa fa-times-circle"/> 
                        <strong>Over Capacity:</strong>
                        This production run exceeds vendor capacity by 
                        <field name="capacity_utilization_pct" readonly="1" nolabel="1" class="oe_inline"/>%.
                        Remove deals or increase capacity before confirming.
                    </div>
                    
                    <notebook>
                        <!-- Phase 3A: Enhanced Allocated Deals tab with Add button -->
                        <page string="Allocated Deals" name="allocated_deals">
                            <group>
                                <button name="action_add_deals" 
                                        string="Add Deals" 
                                        type="object" 
                                        class="btn-primary"
                                        invisible="state not in ['draft', 'confirmed']"/>
                            </group>
                            
                            <field name="deal_ids" readonly="1">
                                <tree string="Allocated Deals" 
                                      create="false"
                                      edit="false">
                                    <field name="name"/>
                                    <field name="customer_id"/>
                                    <field name="rts_current" string="RTS"/>
                                    <!-- Phase 3: TEU and container columns -->
                                    <field name="total_teu" string="TEU" sum="Total TEU" optional="show"/>
                                    <field name="total_containers" string="Containers" optional="show"/>
                                    <field name="container_summary" string="Container Mix" optional="hide"/>
                                    <field name="state"/>
                                    
                                    <!-- Remove button -->
                                    <button name="action_remove_from_production" 
                                            type="object" 
                                            string="Remove" 
                                            class="btn-sm btn-secondary"
                                            invisible="parent.state not in ['draft', 'confirmed']"
                                            confirm="Remove this deal from production run?"/>
                                </tree>
                            </field>
                        </page>
                        
                        <!-- Phase 3: Container Details tab -->
                        <page string="Container Details" 
                              name="container_details"
                              invisible="total_teu == 0">
                            
                            <group string="Totals">
                                <group>
                                    <label for="total_teu"/>
                                    <div class="o_row">
                                        <field name="total_teu" class="oe_inline" readonly="1"/>
                                        <span class="oe_inline"> TEU</span>
                                    </div>
                                    <label for="total_containers"/>
                                    <div class="o_row">
                                        <field name="total_containers" class="oe_inline" readonly="1"/>
                                        <span class="oe_inline"> containers</span>
                                    </div>
                                </group>
                                <group>
                                    <field name="container_summary" readonly="1" string="Summary"/>
                                </group>
                            </group>
                            
                            <group string="Breakdown by Container Type">
                                <field name="container_breakdown" 
                                       nolabel="1" 
                                       readonly="1"
                                       widget="text"
                                       placeholder="No container data available"/>
                            </group>
                            
                        </page>
                        
                        <page string="Notes">
                            <field name="notes" placeholder="Production notes..."/>
                        </page>
                    </notebook>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Production Run Search View - Enhanced -->
    <record id="view_dm_production_run_search" model="ir.ui.view">
        <field name="name">dm.production.run.search</field>
        <field name="model">dm.production.run</field>
        <field name="arch" type="xml">
            <search string="Production Runs">
                <field name="name"/>
                <field name="supplier_id"/>
                
                <separator/>
                
                <!-- Quick Filters -->
                <filter name="active" 
                        string="Active"
                        domain="[('state', 'in', ['draft', 'confirmed', 'production'])]"/>
                
                <filter name="draft" 
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                
                <filter name="confirmed" 
                        string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                
                <filter name="over_capacity" 
                        string="Over Capacity"
                        domain="[('capacity_status_color', '=', 'red')]"/>
                
                <filter name="this_month" 
                        string="This Month"
                        domain="[
                            ('rts_date', '&gt;=', context_today().strftime('%Y-%m-01')),
                            ('rts_date', '&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))
                        ]"/>
                
                <separator/>
                
                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter name="group_by_supplier" 
                            string="Supplier"
                            context="{'group_by': 'supplier_id'}"/>
                    
                    <filter name="group_by_rts_month" 
                            string="RTS Month"
                            context="{'group_by': 'rts_date:month'}"/>
                    
                    <filter name="group_by_state" 
                            string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- ================================================================== -->
    <!-- ACTIONS                                                            -->
    <!-- ================================================================== -->
    
    <!-- Production Run Action -->
    <record id="action_dm_production_run" model="ir.actions.act_window">
        <field name="name">Production Runs</field>
        <field name="res_model">dm.production.run</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'search_default_active': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first production run
            </p>
            <p>
                Production runs group deals allocated for production by a supplier.
            </p>
        </field>
    </record>
    
    
</odoo>
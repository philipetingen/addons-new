<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Production Line Tree View -->
    <record id="view_dm_production_line_tree" model="ir.ui.view">
        <field name="name">dm.production.line.tree</field>
        <field name="model">dm.production.line</field>
        <field name="arch" type="xml">
            <tree string="Production Lines" 
                  decoration-danger="variance_percent &lt; -5"
                  decoration-warning="variance_percent &lt; 0 and variance_percent &gt;= -5"
                  decoration-success="variance_percent &gt;= 0"
                  editable="bottom">
                <field name="production_run_id"/>
                <field name="deal_id"/>
                <field name="product_name"/>
                <field name="packaging_name"/>
                <field name="quantity_ordered" sum="total_ordered"/>
                <field name="quantity_produced" sum="total_produced"/>
                <field name="quantity_variance" sum="total_variance"/>
                <field name="variance_percent" widget="percentage"/>
                
                <!-- Inline Lot Fields (Optional Columns) -->
                <field name="can_edit_inline" column_invisible="1"/>
                <field name="lot_count"/>
                <field name="lot_display" optional="show"/>
                <field name="lot_number_inline" 
                       optional="hide" 
                       readonly="not can_edit_inline"/>
                <field name="production_date_inline" 
                       optional="hide" 
                       readonly="not can_edit_inline"/>
                <field name="expiry_date_inline" 
                       optional="hide" 
                       readonly="not can_edit_inline"/>
                <field name="lot_notes_inline" 
                       optional="hide" 
                       readonly="not can_edit_inline"/>
                
                <field name="lots_complete" widget="boolean" optional="show"/>
                <field name="containers_ordered" sum="total_containers_ordered" optional="hide"/>
                <field name="containers_produced" sum="total_containers_produced" optional="hide"/>
                <field name="teu_ordered" sum="total_teu_ordered" optional="hide"/>
                <field name="teu_produced" sum="total_teu_produced" optional="hide"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_production'"
                       decoration-success="state in ['ready', 'completed']"/>
                
                <!-- Wizard Button -->
                <button name="action_open_lot_wizard" 
                        type="object" 
                        icon="fa-list-ul" 
                        title="Manage Lots (Multiple)"
                        class="btn-link"/>
            </tree>
        </field>
    </record>
    
    <!-- Production Line Form View -->
    <record id="view_dm_production_line_form" model="ir.ui.view">
        <field name="name">dm.production.line.form</field>
        <field name="model">dm.production.line</field>
        <field name="arch" type="xml">
            <form string="Production Line">
                <header>
                    <button name="action_open_lot_wizard" 
                            string="Manage Lots" 
                            type="object" 
                            class="btn-primary"
                            invisible="state not in ['in_production', 'qc_pending', 'ready']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_production,ready,completed"/>
                </header>
                
                <sheet>
                    <group>
                        <group string="Reference">
                            <field name="production_run_id"/>
                            <field name="deal_id"/>
                            <field name="deal_line_id"/>
                            <field name="sequence"/>
                        </group>
                        
                        <group string="Product">
                            <field name="product_id"/>
                            <field name="product_packaging_id"/>
                            <field name="packaging_qty"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Quantities (Packages)">
                            <field name="quantity_ordered"/>
                            <field name="quantity_produced"/>
                            <field name="quantity_variance" 
                                   decoration-danger="quantity_variance &lt; 0"
                                   decoration-success="quantity_variance &gt;= 0"/>
                            <field name="variance_percent" widget="percentage"
                                   decoration-danger="variance_percent &lt; -5"
                                   decoration-warning="variance_percent &lt; 0 and variance_percent &gt;= -5"
                                   decoration-success="variance_percent &gt;= 0"/>
                        </group>
                        
                        <group string="Quantities (Units - Reference)">
                            <field name="quantity_ordered_units"/>
                            <field name="quantity_produced_units"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Containers (Ordered)">
                            <field name="container_type_id"/>
                            <field name="containers_ordered"/>
                            <field name="teu_ordered"/>
                        </group>
                        
                        <group string="Containers (Produced)">
                            <field name="containers_produced"/>
                            <field name="teu_produced"/>
                        </group>
                    </group>
                    
                    <!-- Inline Lot Editing (Single Lot) -->
                    <group string="Lot Details (Single Lot)" invisible="lot_count &gt; 1">
                        <field name="can_edit_inline" invisible="1"/>
                        <group>
                            <field name="lot_number_inline" 
                                   readonly="not can_edit_inline or state not in ['in_production', 'qc_pending', 'ready']"/>
                            <field name="production_date_inline" 
                                   readonly="not can_edit_inline or state not in ['in_production', 'qc_pending', 'ready']"/>
                        </group>
                        <group>
                            <field name="expiry_date_inline" 
                                   readonly="not can_edit_inline or state not in ['in_production', 'qc_pending', 'ready']"/>
                            <field name="lot_notes_inline" 
                                   readonly="not can_edit_inline or state not in ['in_production', 'qc_pending', 'ready']"/>
                        </group>
                    </group>
                    
                    <!-- Multiple Lots Summary -->
                    <group string="Lot Summary" invisible="lot_count == 0">
                        <group>
                            <field name="lot_count"/>
                            <field name="total_lotted_quantity"/>
                        </group>
                        <group>
                            <field name="unlotted_quantity" 
                                   decoration-danger="unlotted_quantity != 0"/>
                            <field name="lots_complete" widget="boolean"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Lots" invisible="lot_count == 0">
                            <field name="lot_ids" nolabel="1">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="lot_number"/>
                                    <field name="quantity" sum="total"/>
                                    <field name="quantity_units" sum="total"/>
                                    <field name="production_date"/>
                                    <field name="expiry_date"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="Notes">
                            <field name="notes" nolabel="1" placeholder="Production notes for this line..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Production Line Search View -->
    <record id="view_dm_production_line_search" model="ir.ui.view">
        <field name="name">dm.production.line.search</field>
        <field name="model">dm.production.line</field>
        <field name="arch" type="xml">
            <search string="Production Lines">
                <field name="production_run_id"/>
                <field name="deal_id"/>
                <field name="product_id"/>
                <field name="product_packaging_id"/>
                <field name="lot_number_inline"/>
                
                <filter string="With Variance" name="filter_variance"
                        domain="[('quantity_variance', '!=', 0)]"/>
                <filter string="Shortage" name="filter_shortage"
                        domain="[('quantity_variance', '&lt;', 0)]"/>
                <filter string="Overage" name="filter_overage"
                        domain="[('quantity_variance', '&gt;', 0)]"/>
                
                <separator/>
                <filter string="Lots Incomplete" name="filter_lots_incomplete"
                        domain="[('lots_complete', '=', False), ('quantity_produced', '&gt;', 0)]"/>
                <filter string="Lots Complete" name="filter_lots_complete"
                        domain="[('lots_complete', '=', True)]"/>
                
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="In Production" name="filter_in_production"
                        domain="[('state', '=', 'in_production')]"/>
                <filter string="Ready" name="filter_ready"
                        domain="[('state', '=', 'ready')]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Production Run" name="group_production_run"
                            context="{'group_by': 'production_run_id'}"/>
                    <filter string="Deal" name="group_deal"
                            context="{'group_by': 'deal_id'}"/>
                    <filter string="Product" name="group_product"
                            context="{'group_by': 'product_id'}"/>
                    <filter string="Package Type" name="group_packaging"
                            context="{'group_by': 'product_packaging_id'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Production Line Action -->
    <record id="action_dm_production_line" model="ir.actions.act_window">
        <field name="name">Production Lines</field>
        <field name="res_model">dm.production.line</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No production lines yet
            </p>
            <p>
                Production lines are created automatically when deals are allocated to production runs.
            </p>
        </field>
    </record>
    
</odoo>
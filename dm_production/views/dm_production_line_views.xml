<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Production Line Tree View -->
    <record id="view_dm_production_line_tree" model="ir.ui.view">
        <field name="name">dm.production.line.tree</field>
        <field name="model">dm.production.line</field>
        <field name="arch" type="xml">
            <tree string="Production Lines" 
                  editable="bottom"
                  decoration-danger="variance_percent &lt; -5"
                  decoration-warning="variance_percent &lt; 0 and variance_percent &gt;= -5"
                  decoration-success="variance_percent &gt; 0">
                
                <field name="sequence" widget="handle"/>
                <field name="production_run_id" optional="hide"/>
                <field name="deal_id" optional="show"/>
                <field name="product_id" readonly="1"/>
                <field name="product_packaging_id" readonly="1"/>
                
                <!-- Quantities -->
                <field name="quantity_ordered" readonly="1" sum="Total Ordered"/>
				<field name="quantity_produced" 
					   sum="Total Produced"
					   readonly="state not in ['in_production', 'qc_pending', 'ready']"/>
                <field name="quantity_variance" readonly="1" sum="Total Variance"/>
                <field name="variance_percent" readonly="1" widget="percentage"/>
                
                <!-- TEU & Containers -->
                <field name="teu_ordered" optional="hide" sum="Total TEU Ordered"/>
                <field name="teu_produced" optional="hide" sum="Total TEU Produced"/>
                <field name="containers_ordered" optional="hide" sum="Total Containers Ordered"/>
                <field name="containers_produced" optional="hide" sum="Total Containers Produced"/>
                
                <!-- Reference fields -->
                <field name="quantity_ordered_units" optional="hide" readonly="1"/>
                <field name="quantity_produced_units" optional="hide" readonly="1"/>
                <field name="packaging_qty" optional="hide" readonly="1"/>
                
                <field name="notes" optional="hide"/>
                <field name="state" optional="show" widget="badge"/>
            </tree>
        </field>
    </record>
    
    <!-- Production Line Form View -->
    <record id="view_dm_production_line_form" model="ir.ui.view">
        <field name="name">dm.production.line.form</field>
        <field name="model">dm.production.line</field>
        <field name="arch" type="xml">
            <form string="Production Line">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_production,qc_pending,ready,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Future: Add smart buttons for lots, QC -->
                    </div>
                    
                    <group>
                        <group name="source">
                            <field name="production_run_id" readonly="1"/>
                            <field name="deal_id" readonly="1"/>
                            <field name="deal_line_id" readonly="1"/>
                            <field name="sequence"/>
                        </group>
                        <group name="product">
                            <field name="product_id" readonly="1"/>
                            <field name="product_packaging_id" readonly="1"/>
                            <field name="packaging_qty" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Quantities (Package-Native)">
                        <group name="quantities">
                            <field name="quantity_ordered" readonly="1"/>
							<field name="quantity_produced" 
								   readonly="state not in ['in_production', 'qc_pending', 'ready']"/>
                            <field name="quantity_variance" readonly="1"/>
                            <field name="variance_percent" widget="percentage" readonly="1"/>
                        </group>
                        <group name="unit_reference">
                            <field name="quantity_ordered_units" readonly="1"/>
                            <field name="quantity_produced_units" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Container &amp; TEU Calculations">
                        <group name="containers">
                            <field name="container_type_id" readonly="1"/>
                            <field name="containers_ordered" readonly="1"/>
                            <field name="containers_produced" readonly="1"/>
                        </group>
                        <group name="teu">
                            <field name="teu_ordered" readonly="1"/>
                            <field name="teu_produced" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Production Notes" name="notes">
                            <field name="notes" placeholder="Enter production notes, issues, or observations..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Production Line Search View -->
    <record id="view_dm_production_line_search" model="ir.ui.view">
        <field name="name">dm.production.line.search</field>
        <field name="model">dm.production.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="production_run_id"/>
                <field name="deal_id"/>
                <field name="product_id"/>
                <field name="product_packaging_id"/>
                
                <filter string="Shortage" name="shortage" 
                        domain="[('variance_percent', '&lt;', 0)]"/>
                <filter string="Significant Shortage (&gt;5%)" name="significant_shortage" 
                        domain="[('variance_percent', '&lt;', -5)]"/>
                <filter string="Overproduction" name="overproduction" 
                        domain="[('variance_percent', '&gt;', 0)]"/>
                <filter string="No Variance" name="exact" 
                        domain="[('variance_percent', '=', 0)]"/>
                
                <separator/>
                <filter string="Not Produced" name="not_produced" 
                        domain="[('quantity_produced', '=', 0)]"/>
                
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Production Run" name="group_pr" 
                            context="{'group_by': 'production_run_id'}"/>
                    <filter string="Deal" name="group_deal" 
                            context="{'group_by': 'deal_id'}"/>
                    <filter string="Product" name="group_product" 
                            context="{'group_by': 'product_id'}"/>
                    <filter string="Package" name="group_package" 
                            context="{'group_by': 'product_packaging_id'}"/>
                    <filter string="State" name="group_state" 
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Production Line Action -->
    <record id="action_dm_production_line" model="ir.actions.act_window">
        <field name="name">Production Lines</field>
        <field name="res_model">dm.production.line</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No production lines yet
            </p>
            <p>
                Production lines are created automatically when deals are allocated to production runs.
            </p>
        </field>
    </record>
    
</odoo>
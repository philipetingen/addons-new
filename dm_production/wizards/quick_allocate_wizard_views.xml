<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Quick Allocate Wizard Form -->
    <record id="view_production_quick_allocate_wizard_form" model="ir.ui.view">
        <field name="name">dm.production.quick.allocate.wizard.form</field>
        <field name="model">dm.production.quick.allocate.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Allocate to Production">
                <sheet>
                    <!-- Deal Information Header -->
                    <group name="deal_info">
                        <group string="Deal Information" name="deal_details">
                            <field name="deal_id" invisible="1"/>
                            <field name="deal_name"/>
                            <field name="customer_name"/>
                            <field name="rts_date"/>
                        </group>
                        <group string="Quantities" name="deal_quantities">
                            <field name="product_mix"/>
                            <field name="deal_containers"/>
                            <field name="deal_teu" string="TEU"/>
                        </group>
                    </group>
                    
                    <group name="supplier_info">
                        <field name="supplier_id"/>
                        <field name="available_pr_count" string="Available Production Runs"/>
                    </group>
                    
                    <separator string="Select Production Run"/>
                    
                    <!-- Allocation Mode Selection - PROMINENT -->
                    <group name="allocation_mode_group">
                        <label for="allocation_mode" string="Allocation Mode"/>
                        <div>
                            <field name="allocation_mode" widget="radio" class="o_horizontal"/>
                        </div>
                    </group>
                    
                    <separator/>
                    
                    <!-- New PR Fields (when creating new) -->
                    <group name="new_pr_group" 
                           string="New Production Run Details" 
                           invisible="allocation_mode != 'new'">
                        <field name="new_pr_rts_date" 
                               string="Target RTS Date"
                               required="allocation_mode == 'new'"/>
                        <field name="new_pr_production_start"
                               string="Production Start Date"/>
                    </group>
                    
                    <!-- Existing PR Selection (when allocating to existing) -->
                    <group name="existing_pr_group" 
                           string="Select Production Run"
                           invisible="allocation_mode != 'existing'">
                        <field name="production_run_id" 
                               options="{'no_create': True, 'no_open': True}"
                               required="allocation_mode == 'existing'"/>
                        <button name="action_view_production_run" 
                                string="View Production Run Details" 
                                type="object"
                                class="btn-link"
                                invisible="not production_run_id"/>
                    </group>
                    
                    <!-- Capacity Impact Preview (only for existing PR) -->
                    <group name="capacity_preview" 
                           string="Capacity Impact Preview" 
                           invisible="allocation_mode != 'existing' or not production_run_id">
                        <group name="current_capacity">
                            <label for="current_pr_teu" string="Current"/>
                            <div class="o_row">
                                <field name="current_pr_teu" string="TEU"/>
                                <span invisible="pr_capacity_teu == 0"> / </span>
                                <field name="pr_capacity_teu" invisible="pr_capacity_teu == 0"/>
                                <span invisible="pr_capacity_teu == 0"> TEU</span>
                            </div>
                        </group>
                        <group name="after_capacity">
                            <label for="new_pr_teu" string="After Allocation"/>
                            <div class="o_row">
                                <field name="new_pr_teu" string="TEU"/>
                                <span invisible="pr_capacity_teu == 0"> / </span>
                                <field name="pr_capacity_teu" invisible="1"/>
                                <span invisible="pr_capacity_teu == 0"> TEU</span>
                            </div>
                            <field name="new_utilization" 
                                   widget="progressbar" 
                                   invisible="pr_capacity_teu == 0"
                                   options="{'style': 'width: 200px'}"/>
                            <field name="capacity_status_color" invisible="1"/>
                        </group>
                    </group>
                    
                    <!-- Capacity Warning -->
                    <div class="alert alert-warning" 
                         role="alert"
                         invisible="not show_capacity_warning or capacity_status_color == 'green'">
                        <i class="fa fa-exclamation-triangle"/> 
                        <strong>Capacity Warning:</strong>
                        <field name="capacity_warning_message" nolabel="1"/>
                        <field name="show_capacity_warning" invisible="1"/>
                    </div>
                    
                    <!-- Capacity Error -->
                    <div class="alert alert-danger" 
                         role="alert"
                         invisible="capacity_status_color != 'red'">
                        <i class="fa fa-times-circle"/> 
                        <strong>Cannot Allocate - Capacity Exceeded:</strong>
                        <field name="capacity_warning_message" nolabel="1"/>
                    </div>
                    
                    <!-- Available PRs List (for reference when selecting existing) -->
                    <notebook invisible="allocation_mode != 'existing' or available_pr_count == 0">
                        <page string="Available Production Runs" name="available_prs">
                            <field name="available_pr_ids" mode="tree" nolabel="1">
                                <tree string="Available Production Runs" 
                                      create="false" 
                                      edit="false"
                                      decoration-success="capacity_status_color == 'green'"
                                      decoration-warning="capacity_status_color == 'yellow'"
                                      decoration-danger="capacity_status_color == 'red'">
                                    <field name="name"/>
                                    <field name="rts_date"/>
                                    <field name="deal_count" string="Deals"/>
                                    <field name="total_teu" string="TEU" optional="show"/>
                                    <field name="capacity_utilization_pct" 
                                           string="Utilization" 
                                           widget="progressbar"
                                           optional="show"/>
                                    <field name="capacity_status_color" column_invisible="1"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    
                    <!-- Helper fields -->
                    <field name="has_capacity_module" invisible="1"/>
                    
                </sheet>
                
                <footer>
                    <button name="action_allocate" 
                            string="Allocate" 
                            type="object" 
                            class="btn-primary"
                            invisible="allocation_mode == 'existing' and capacity_status_color == 'red'"/>
                    <button name="action_allocate" 
                            string="Force Allocate (Over Capacity)" 
                            type="object" 
                            class="btn-danger"
                            invisible="allocation_mode != 'existing' or capacity_status_color != 'red'"
                            confirm="This will exceed capacity limits. Are you sure you want to continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Quick Allocate Wizard Action -->
    <record id="action_production_quick_allocate_wizard" model="ir.actions.act_window">
        <field name="name">Quick Allocate to Production</field>
        <field name="res_model">dm.production.quick.allocate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
</odoo>
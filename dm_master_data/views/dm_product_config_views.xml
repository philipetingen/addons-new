<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================================ -->
    <!-- COLLECTIONS -->
    <!-- ============================================================================ -->
    <record id="dm_collection_tree_view" model="ir.ui.view">
        <field name="name">dm.collection.tree</field>
        <field name="model">dm.collection</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    
    <record id="dm_collection_form_view" model="ir.ui.view">
        <field name="name">dm.collection.form</field>
        <field name="model">dm.collection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="dm_collection_action" model="ir.actions.act_window">
        <field name="name">Collections</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dm.collection</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new collection
            </p>
            <p>
                Collections help categorize products by season, theme, or marketing campaign.
            </p>
        </field>
    </record>


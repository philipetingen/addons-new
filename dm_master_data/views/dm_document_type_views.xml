<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Tree View -->
        <record id="view_dm_document_type_tree" model="ir.ui.view">
            <field name="name">dm.document.type.tree</field>
            <field name="model">dm.document.type</field>
            <field name="arch" type="xml">
                <tree string="Document Types">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="document_source"/>
                    <field name="required_for"/>
                    <field name="required_before"/>
                    <field name="is_mandatory"/>
                    <field name="blocks_shipment" optional="hide"/>
                    <field name="active" invisible="1"/>
                </tree>
            </field>
        </record>
        
        <!-- Form View -->
        <record id="view_dm_document_type_form" model="ir.ui.view">
            <field name="name">dm.document.type.form</field>
            <field name="model">dm.document.type</field>
            <field name="arch" type="xml">
                <form string="Document Type">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Document Type Name"/>
                            </h1>
                            <h2>
                                <field name="code" placeholder="Document Code"/>
                            </h2>
                        </div>
                        
                        <group>
                            <group string="Classification">
                                <field name="category"/>
                                <field name="document_source"/>
                                <field name="sequence"/>
                            </group>
                            <group string="Requirements">
                                <field name="required_for"/>
                                <field name="required_before"/>
                                <field name="is_mandatory"/>
                                <field name="blocks_shipment"/>
                            </group>
                        </group>
                        
                        <group>
                            <group string="Validity">
                                <field name="has_expiry"/>
                                <field name="validity_days" invisible="has_expiry == False"/>
                            </group>
                            <group string="Status">
                                <field name="active"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Checklist Items">
                                <group>
                                    <field name="checklist_items" nolabel="1" placeholder="Enter checklist items, one per line..."/>
                                </group>
                            </page>
                            <page string="Instructions">
                                <group>
                                    <field name="instructions" nolabel="1" placeholder="Instructions for obtaining/completing this document..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
    </data>
</odoo>
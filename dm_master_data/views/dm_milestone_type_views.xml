<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Tree View -->
    <record id="view_dm_milestone_type_tree" model="ir.ui.view">
        <field name="name">dm.milestone.type.tree</field>
        <field name="model">dm.milestone.type</field>
        <field name="arch" type="xml">
            <tree string="Milestone Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="milestone_code"/>
                <field name="milestone_type"/>
                <field name="typical_days_from_order"/>
                <field name="default_timing"/>
                <field name="default_days"/>
                <field name="is_payment_trigger" widget="boolean_toggle"/>
                <field name="is_customer_visible" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_dm_milestone_type_form" model="ir.ui.view">
        <field name="name">dm.milestone.type.form</field>
        <field name="model">dm.milestone.type</field>
        <field name="arch" type="xml">
            <form string="Milestone Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment_terms" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-percent"
                                invisible="payment_term_count == 0">
                            <field name="payment_term_count" widget="statinfo" string="Payment Terms"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    
                    <group>
                        <group string="Basic Information">
                            <field name="name"/>
                            <field name="milestone_code"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Classification">
                            <field name="milestone_type"/>
                            <field name="is_payment_trigger" widget="boolean_toggle"/>
                            <field name="is_customer_visible" widget="boolean_toggle"/>
                            <field name="typical_days_from_order"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Date Mapping">
                            <field name="deal_date_field"/>
                            <field name="primary_date_field"/>
                            <field name="fallback_date_field"/>
                        </group>
                        <group string="Payment Timing">
                            <field name="default_timing"/>
                            <field name="default_days"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Special Flags">
                            <field name="requires_confirmation" widget="boolean_toggle"/>
                            <field name="blocking_milestone" widget="boolean_toggle"/>
                        </group>
                    </group>
                    
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_dm_milestone_type_search" model="ir.ui.view">
        <field name="name">dm.milestone.type.search</field>
        <field name="model">dm.milestone.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="milestone_code"/>
                
                <filter string="Payment Triggers" name="payment_trigger" 
                        domain="[('is_payment_trigger', '=', True)]"/>
                <filter string="Customer Visible" name="customer_visible" 
                        domain="[('is_customer_visible', '=', True)]"/>
                <filter string="Requires Confirmation" name="requires_confirmation" 
                        domain="[('requires_confirmation', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'milestone_type'}"/>
                    <filter string="Timing" name="group_timing" context="{'group_by': 'default_timing'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_dm_milestone_type" model="ir.actions.act_window">
        <field name="name">Milestone Types</field>
        <field name="res_model">dm.milestone.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No milestone types defined
            </p>
            <p>
                Milestone types define the key events in your deal execution process
                that can trigger payments or other actions.
            </p>
        </field>
    </record>
    
</odoo>
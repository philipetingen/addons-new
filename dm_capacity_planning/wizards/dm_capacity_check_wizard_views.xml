<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Capacity Check Wizard Form -->
    <record id="view_dm_capacity_check_wizard_form" model="ir.ui.view">
        <field name="name">dm.capacity.check.wizard.form</field>
        <field name="model">dm.capacity.check.wizard</field>
        <field name="arch" type="xml">
            <form string="Capacity Check">
                <header>
                    <button name="action_check_capacity" string="Check Capacity" 
                            type="object" class="oe_highlight" 
                            invisible="state == 'result'"/>
                    <button name="action_reset" string="Check Again" 
                            type="object" class="btn-secondary" 
                            invisible="state == 'input'"/>
                    <button name="action_close" string="Close" 
                            type="object" class="btn-secondary"/>
                </header>
                
                <sheet>
                    <!-- INPUT STATE -->
                    <group invisible="state == 'result'">
                        <group>
                            <field name="state" invisible="1"/>
                            <field name="vendor_id"/>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                        </group>
                    </group>
                    
                    <!-- PROGRESS (during check) -->
                    <group invisible="not progress_message">
                        <field name="progress_message" readonly="1"/>
                        <field name="progress_percent" widget="progressbar" readonly="1"/>
                    </group>
                    
                    <!-- RESULTS STATE -->
                    <group invisible="state == 'input'">
                        <group>
                            <field name="vendor_id" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="check_passed" readonly="1"/>
                            <field name="violation_count" readonly="1" 
                                   invisible="violation_count == 0"/>
                        </group>
                    </group>
                    
                    <notebook invisible="state == 'input'">
                        <page string="Results" name="results">
                            <field name="result_message" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Capacity Check Action -->
    <record id="action_dm_capacity_check_wizard" model="ir.actions.act_window">
        <field name="name">Check Vendor Capacity</field>
        <field name="res_model">dm.capacity.check.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_res_partner"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ================================================================== -->
        <!-- PRODUCTION RUN VIEW EXTENSION - Phase 1 + Phase 2                 -->
        <!-- ================================================================== -->
        
        <!-- Phase 1: Add capacity info to production run form -->
        <record id="view_dm_production_run_form_capacity" model="ir.ui.view">
            <field name="name">dm.production.run.form.capacity</field>
            <field name="model">dm.production.run</field>
            <field name="inherit_id" ref="dm_production.view_dm_production_run_form"/>
            <field name="arch" type="xml">
                
                <!-- Add Check Capacity button in header -->
                <button name="action_confirm" position="before">
                    <button name="action_check_capacity"
                            string="Check Capacity"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ['draft', 'confirmed']"
                            help="Check if this production run fits within vendor capacity"/>
                </button>
                
                <!-- Add Capacity utilization stat button to button box -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="%(dm_capacity_planning.action_dm_capacity_check_wizard)d" 
                            type="action"
                            class="oe_stat_button" 
                            icon="fa-tachometer"
                            invisible="capacity_utilization_pct == 0"
                            context="{'default_production_run_id': id}">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="capacity_utilization_pct" widget="float" options="{'precision': 0}"/>%
                            </span>
                            <span class="o_stat_text">Capacity</span>
                        </div>
                        <field name="capacity_status_color" invisible="1"/>
                    </button>
                </xpath>
                
                <!-- Add capacity fields after company_id -->
                <field name="company_id" position="after">
                    <field name="vendor_capacity_id" 
                           readonly="1"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="capacity_status" 
                           widget="badge"
                           decoration-success="capacity_status == 'ok'"
                           decoration-warning="capacity_status == 'warning'"
                           decoration-danger="capacity_status == 'over'"
                           decoration-muted="capacity_status == 'no_capacity'"/>
                    <field name="capacity_violations" 
                           readonly="1"
                           invisible="capacity_violations == False"
                           class="text-warning"/>
                    <!-- Phase 2: Add run TEU -->
                    <field name="run_total_teu" readonly="1"/>
                </field>
                
                <!-- Phase 3A: Capacity Overview Banner -->
                <xpath expr="//group[1]" position="after">
                    <div class="alert alert-info" 
                         role="alert"
                         invisible="month_capacity_teu == 0">
                        <div class="row">
                            <div class="col-md-3">
                                <strong>Month Capacity:</strong>
                                <div class="o_row">
                                    <field name="month_capacity_teu" readonly="1" class="oe_inline"/>
                                    <span class="oe_inline"> TEU</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <strong>Used:</strong>
                                <div class="o_row">
                                    <field name="month_total_teu" readonly="1" class="oe_inline"/>
                                    <span class="oe_inline"> TEU</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <strong>Available:</strong>
                                <div class="o_row">
                                    <field name="month_available_teu" 
                                           readonly="1" 
                                           class="oe_inline"
                                           decoration-success="month_available_teu &gt;= 0"
                                           decoration-danger="month_available_teu &lt; 0"/>
                                    <span class="oe_inline"> TEU</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <strong>Utilization:</strong>
                                <div class="o_row">
                                    <field name="capacity_utilization_pct" 
                                           readonly="1" 
                                           widget="percentage"
                                           class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
                
                <!-- Phase 2: Add Capacity Analysis tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="Capacity Analysis" 
                          name="capacity_analysis"
                          invisible="not vendor_capacity_id">
                        
                        <!-- Month Overview -->
                        <group string="Month Capacity Overview">
                            <group>
                                <label for="month_total_teu" string="Month Usage"/>
                                <div class="o_row">
                                    <field name="month_total_teu" readonly="1" class="oe_inline"/>
                                    <span class="oe_inline"> / </span>
                                    <field name="month_capacity_teu" readonly="1" class="oe_inline"/>
                                    <span class="oe_inline"> TEU</span>
                                </div>
                                
                                <field name="month_utilization_percent" 
                                       widget="progressbar"
                                       readonly="1"
                                       decoration-success="month_utilization_percent &lt; 80"
                                       decoration-warning="month_utilization_percent &gt;= 80 and month_utilization_percent &lt; 100"
                                       decoration-danger="month_utilization_percent &gt;= 100"/>
                            </group>
                            <group>
                                <field name="month_available_teu" 
                                       readonly="1"
                                       decoration-success="month_available_teu &gt;= 0"
                                       decoration-danger="month_available_teu &lt; 0"/>
                            </group>
                        </group>
                        
                        <!-- Capacity Status Details -->
                        <group string="Status Details" invisible="not capacity_violations">
                            <field name="capacity_violations" 
                                   nolabel="1" 
                                   readonly="1"
                                   widget="text"
                                   options="{'no_resize': True}"/>
                        </group>
                        
                        <!-- Action Buttons -->
                        <div class="oe_button_box" style="margin-top: 20px;">
                            <button name="action_check_capacity" 
                                    type="object" 
                                    string="View Detailed Report" 
                                    class="btn-primary"
                                    icon="fa-pie-chart"/>
                        </div>
                        
                    </page>
                </xpath>
                
            </field>
        </record>
        
        <!-- Phase 1+2+3A: Add capacity columns to production run tree -->
        <record id="view_dm_production_run_tree_capacity" model="ir.ui.view">
            <field name="name">dm.production.run.tree.capacity</field>
            <field name="model">dm.production.run</field>
            <field name="inherit_id" ref="dm_production.view_dm_production_run_tree"/>
            <field name="arch" type="xml">
                
                <!-- Phase 3A: Add tree-level decorations based on capacity status -->
                <tree position="attributes">
                    <attribute name="decoration-success">capacity_status_color == 'green'</attribute>
                    <attribute name="decoration-warning">capacity_status_color == 'yellow'</attribute>
                    <attribute name="decoration-danger">capacity_status_color == 'red'</attribute>
                </tree>
                
                <!-- Add capacity columns before state -->
                <field name="state" position="before">
                    <!-- Phase 2: TEU column -->
                    <field name="run_total_teu" 
                           string="TEU" 
                           optional="show"
                           sum="Total TEU"/>
                    <!-- Phase 3A: Capacity utilization -->
                    <field name="capacity_utilization_pct" 
                           string="Utilization" 
                           widget="progressbar"
                           optional="show"/>
                    <!-- Phase 2: Month utilization -->
                    <field name="month_utilization_percent" 
                           string="Month %" 
                           optional="hide"
                           widget="progressbar"
                           decoration-success="month_utilization_percent &lt; 80"
                           decoration-warning="month_utilization_percent &gt;= 80 and month_utilization_percent &lt; 100"
                           decoration-danger="month_utilization_percent &gt;= 100"/>
                    <!-- Phase 1+2: Capacity status -->
                    <field name="capacity_status" 
                           optional="show"
                           widget="badge"
                           decoration-success="capacity_status == 'ok'"
                           decoration-warning="capacity_status == 'warning'"
                           decoration-danger="capacity_status == 'over'"
                           decoration-muted="capacity_status == 'no_capacity'"/>
                    <!-- Phase 3A: Hidden field for tree decorations -->
                    <field name="capacity_status_color" column_invisible="1"/>
                </field>
                
            </field>
        </record>
        
        <!-- Phase 2: Search view (standalone - dm_production doesn't have one) -->
        <record id="view_dm_production_run_search" model="ir.ui.view">
            <field name="name">dm.production.run.search</field>
            <field name="model">dm.production.run</field>
            <field name="arch" type="xml">
                <search string="Production Runs">
                    <field name="name"/>
                    <field name="supplier_id"/>
                    <field name="rts_date"/>
                    
                    <!-- State filters -->
                    <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="state_confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="In Production" name="state_production" domain="[('state', '=', 'production')]"/>
                    <filter string="Ready" name="state_ready" domain="[('state', '=', 'ready')]"/>
                    <filter string="Done" name="state_done" domain="[('state', '=', 'done')]"/>
                    
                    <separator/>
                    
                    <!-- Capacity filters -->
                    <filter string="Within Capacity" name="capacity_ok" domain="[('capacity_status', '=', 'ok')]"/>
                    <filter string="Near Capacity" name="capacity_warning" domain="[('capacity_status', '=', 'warning')]"/>
                    <filter string="Over Capacity" name="capacity_over" domain="[('capacity_status', '=', 'over')]"/>
                    <filter string="No Capacity" name="no_capacity" domain="[('capacity_status', '=', 'no_capacity')]"/>
                    
                    <separator/>
                    
                    <!-- Phase 3A: Color-based capacity filter -->
                    <filter name="over_capacity" 
                            string="Over Capacity (Red)"
                            domain="[('capacity_status_color', '=', 'red')]"/>
                    
                    <!-- Group by options -->
                    <group expand="0" string="Group By">
                        <filter string="Supplier" name="group_by_supplier" context="{'group_by': 'supplier_id'}"/>
                        <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Capacity Status" name="group_by_capacity_status" context="{'group_by': 'capacity_status'}"/>
                        <filter string="RTS Month" name="group_by_rts_month" context="{'group_by': 'rts_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Phase 2: Graph view -->
        <record id="view_dm_production_run_graph_capacity" model="ir.ui.view">
            <field name="name">dm.production.run.graph.capacity</field>
            <field name="model">dm.production.run</field>
            <field name="arch" type="xml">
                <graph string="Production Run Capacity Analysis" type="bar">
                    <field name="rts_date" interval="month"/>
                    <field name="run_total_teu" type="measure"/>
                </graph>
            </field>
        </record>
        
        <!-- Phase 2: Pivot view -->
        <record id="view_dm_production_run_pivot_capacity" model="ir.ui.view">
            <field name="name">dm.production.run.pivot.capacity</field>
            <field name="model">dm.production.run</field>
            <field name="arch" type="xml">
                <pivot string="Production Run Capacity Pivot">
                    <field name="supplier_id" type="row"/>
                    <field name="rts_date" interval="month" type="col"/>
                    <field name="run_total_teu" type="measure"/>
                    <field name="month_utilization_percent" type="measure"/>
                </pivot>
            </field>
        </record>
        
    </data>
</odoo>
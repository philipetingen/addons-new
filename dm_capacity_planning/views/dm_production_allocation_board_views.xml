<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ================================================================== -->
        <!-- PRODUCTION ALLOCATION BOARD VIEWS                                  -->
        <!-- ================================================================== -->
        
        <!-- Allocation Board Form -->
        <record id="view_production_allocation_board_form" model="ir.ui.view">
            <field name="name">dm.production.allocation.board.form</field>
            <field name="model">dm.production.allocation.board</field>
            <field name="arch" type="xml">
                <form string="Production Allocation Board">
                    <header>
                        <button name="action_refresh" string="Refresh" type="object" class="btn-secondary"/>
                        <button name="action_create_production_run" string="Create Production Run" type="object" class="btn-primary"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>Production Allocation Board</h1>
                            <h3>Plan production runs and allocate deals</h3>
                        </div>
                        
                        <!-- Filters -->
                        <group string="Filters">
                            <group>
                                <field name="supplier_id" options="{'no_create': True}"/>
                                <field name="date_from"/>
                            </group>
                            <group>
                                <field name="date_to"/>
                                <label for="total_unallocated_teu"/>
                                <div>
                                    <strong><field name="total_unallocated_teu" class="oe_inline"/> TEU</strong>
                                    <span class="oe_inline"> unallocated</span>
                                </div>
                            </group>
                        </group>
                        
                        <!-- Selection Stats -->
                        <group string="Selection" invisible="selected_count == 0">
                            <group>
                                <label for="selected_count"/>
                                <div>
                                    <strong><field name="selected_count" class="oe_inline"/> deals</strong>
                                    <span class="oe_inline"> selected</span>
                                </div>
                            </group>
                            <group>
                                <label for="selected_teu"/>
                                <div>
                                    <strong><field name="selected_teu" class="oe_inline"/> TEU</strong>
                                    <span class="oe_inline"> total</span>
                                </div>
                            </group>
                        </group>
                        
                        <notebook>
                            <!-- Unallocated Deals Tab -->
                            <page string="Unallocated Deals" name="unallocated">
                                <group>
                                    <field name="unallocated_count" invisible="1"/>
                                    <field name="selected_count" invisible="1"/>
                                    <div class="alert alert-info" invisible="unallocated_count &gt; 0">
                                        <strong>✅ All Clear!</strong> No unallocated deals matching filters.
                                    </div>
                                </group>
                                
                                <!-- Instructions -->
                                <div class="alert alert-info" style="margin: 10px 0;">
                                    <strong>💡 How to select deals:</strong> Click in the "Select Deals" field below and choose from the dropdown list. Selected deals will appear as tags. Then click "Create Production Run" to auto-fill supplier and RTS date.
                                </div>
                                
                                <!-- Selection Stats -->
                                <div class="alert alert-success" invisible="selected_count == 0" style="margin: 10px 0;">
                                    <strong>✓ Selected:</strong> <field name="selected_count" class="oe_inline"/> deals, <field name="selected_teu" class="oe_inline"/> TEU total
                                </div>
                                
                                <!-- Editable selection field with tags -->
                                <group string="Select Deals to Allocate">
                                    <field name="selected_deal_ids" 
                                           widget="many2many_tags" 
                                           placeholder="Click to select deals..."
                                           domain="[('id', 'in', unallocated_deal_ids)]"
                                           options="{'no_create': True, 'color_field': 'state'}"
                                           nolabel="1"/>
                                </group>
                                
                                <!-- Read-only view of ALL unallocated deals -->
                                <group string="All Unallocated Deals (Read-Only)">
                                    <field name="unallocated_deal_ids" nolabel="1" mode="tree">
                                        <tree string="Unallocated Deals" 
                                              create="0" 
                                              delete="0"
                                              decoration-success="id in parent.selected_deal_ids">
                                            <field name="name"/>
                                            <field name="customer_id"/>
                                            <field name="supplier_id" optional="hide"/>
                                            <field name="rts_current" string="RTS Date"/>
                                            <field name="total_teu" string="TEU" sum="Total TEU" optional="show"/>
                                            <field name="total_containers" string="Containers" optional="show"/>
                                            <field name="container_summary" string="Container Mix" optional="hide"/>
                                            <field name="state" widget="badge"/>
                                            <button name="%(dm_production.action_production_quick_allocate_wizard)d" 
                                                    string="Allocate" 
                                                    type="action" 
                                                    icon="fa-bolt"
                                                    class="btn-sm btn-primary"
                                                    context="{'default_deal_id': active_id}"/>
                                        </tree>
                                    </field>
                                </group>
                                
                            </page>
                            
                            <!-- Production Runs Tab -->
                            <page string="Production Runs" name="production_runs">
                                <group>
                                    <field name="production_run_count" invisible="1"/>
                                    <div class="alert alert-warning" invisible="production_run_count &gt; 0">
                                        <strong>⚠️ No Production Runs</strong> Create a production run to start allocating deals.
                                    </div>
                                </group>
                                
                                <field name="production_run_ids" nolabel="1">
                                    <tree string="Production Runs" create="0" delete="0">
                                        <field name="name"/>
                                        <field name="supplier_id"/>
                                        <field name="rts_date" string="RTS Date"/>
                                        <field name="deal_count" string="Deals"/>
                                        <field name="total_teu" string="TEU" sum="Total TEU"/>
                                        <field name="total_containers" string="Containers" optional="hide"/>
                                        <field name="month_utilization_percent" 
                                               string="Capacity %" 
                                               widget="progressbar"
                                               optional="show"
                                               decoration-success="month_utilization_percent &lt; 80"
                                               decoration-warning="month_utilization_percent &gt;= 80 and month_utilization_percent &lt; 100"
                                               decoration-danger="month_utilization_percent &gt;= 100"/>
                                        <field name="capacity_status" 
                                               widget="badge"
                                               optional="show"
                                               decoration-success="capacity_status == 'ok'"
                                               decoration-warning="capacity_status == 'warning'"
                                               decoration-danger="capacity_status == 'over'"/>
                                        <field name="state" widget="badge"/>
                                        <button name="action_view_deals" 
                                                string="View Deals" 
                                                type="object" 
                                                icon="fa-list"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        
                    </sheet>
                </form>
            </field>
        </record>
        
    </data>
</odoo>
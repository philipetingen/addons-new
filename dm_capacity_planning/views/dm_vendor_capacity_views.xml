<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ================================================================== -->
        <!-- VENDOR CAPACITY VIEWS                                              -->
        <!-- ================================================================== -->
        
        <!-- Tree View -->
        <record id="view_dm_vendor_capacity_tree" model="ir.ui.view">
            <field name="name">dm.vendor.capacity.tree</field>
            <field name="model">dm.vendor.capacity</field>
            <field name="arch" type="xml">
                <tree string="Vendor Capacity Records"
                      decoration-success="status_badge == 'current'"
                      decoration-info="status_badge == 'future'"
                      decoration-muted="status_badge == 'expired'">
                    
                    <field name="status_badge" invisible="1"/>
                    <field name="entry_mode" invisible="1"/>
                    
                    <field name="vendor_id"/>
                    <field name="valid_from"/>
                    <field name="valid_to"/>
                    <field name="display_period" optional="show"/>
                    
                    <field name="effective_capacity_teu" string="Capacity (TEU/Month)" sum="Total TEU"/>
                    
                    <field name="capacity_containers" 
                           invisible="entry_mode == 'teu'"
                           optional="show"/>
                    <field name="container_type_id" 
                           invisible="entry_mode == 'teu'"
                           optional="show"/>
                    
                    <field name="constraint_count" string="Constraints"/>
                    
                    <field name="status_badge" 
                           widget="badge"
                           decoration-success="status_badge == 'current'"
                           decoration-info="status_badge == 'future'"
                           decoration-muted="status_badge == 'expired'"/>
                    
                    <field name="active" widget="boolean_toggle" optional="show"/>
                </tree>
            </field>
        </record>
        
        <!-- Form View -->
        <record id="view_dm_vendor_capacity_form" model="ir.ui.view">
            <field name="name">dm.vendor.capacity.form</field>
            <field name="model">dm.vendor.capacity</field>
            <field name="arch" type="xml">
                <form string="Vendor Capacity">
                    <header>
                        <field name="status_badge" widget="statusbar"/>
                        
                        <button name="action_clone_capacity" 
                                string="Clone to New Period"
                                type="object"
                                class="oe_highlight"
                                help="Create a new capacity record starting after this one ends"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_constraints"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-filter"
                                    invisible="constraint_count == 0">
                                <field name="constraint_count" widget="statinfo" string="Constraints"/>
                            </button>
                        </div>
                        
                        <widget name="web_ribbon" title="Current" bg_color="bg-success" invisible="status_badge != 'current'"/>
                        <widget name="web_ribbon" title="Future" bg_color="bg-info" invisible="status_badge != 'future'"/>
                        <widget name="web_ribbon" title="Expired" bg_color="bg-secondary" invisible="status_badge != 'expired'"/>
                        
                        <group>
                            <group string="Vendor">
                                <field name="vendor_id" 
                                       options="{'no_create': True}"
                                       domain="[('supplier_rank', '>', 0)]"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            
                            <group string="Validity Period">
                                <field name="valid_from"/>
                                <field name="valid_to" 
                                       placeholder="Leave empty for ongoing capacity"/>
                                <field name="display_period" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Capacity Entry">
                            <group>
                                <field name="period_type" readonly="1"/>
                                <field name="entry_mode" widget="radio"/>
                            </group>
                        </group>
                        
                        <group invisible="entry_mode == 'containers'">
                            <group string="Direct TEU Entry">
                                <field name="capacity_teu" 
                                       required="entry_mode == 'teu'"
                                       invisible="entry_mode == 'containers'"/>
                            </group>
                            <group/>
                        </group>
                        
                        <group invisible="entry_mode == 'teu'">
                            <group string="Container-Based Entry">
                                <field name="capacity_containers" 
                                       required="entry_mode == 'containers'"
                                       invisible="entry_mode == 'teu'"/>
                                <field name="container_type_id" 
                                       required="entry_mode == 'containers'"
                                       invisible="entry_mode == 'teu'"
                                       options="{'no_create': True}"/>
                            </group>
                            <group/>
                        </group>
                        
                        <group>
                            <group string="Effective Capacity">
                                <label for="effective_capacity_teu" string="Total Capacity"/>
                                <div class="o_row">
                                    <field name="effective_capacity_teu" class="oe_inline" readonly="1"/>
                                    <span class="oe_inline">TEU per month</span>
                                </div>
                            </group>
                            <group/>
                        </group>
                        
                        <notebook>
                            <page string="Specific Constraints" name="constraints">
                                <field name="constraint_ids">
                                    <tree string="Capacity Constraints">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="constraint_type"/>
                                        <field name="product_count" 
                                               invisible="constraint_type != 'product'"
                                               string="# Products"/>
                                        <field name="category_count" 
                                               invisible="constraint_type != 'category'"
                                               string="# Categories"/>
                                        <field name="display_scope"/>
                                        <field name="effective_max_capacity_teu" string="Max TEU/Month"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </tree>
                                </field>
                                
                                <div class="oe_grey" style="margin-top: 10px;">
                                    <p><strong>About Constraints:</strong></p>
                                    <ul>
                                        <li>Constraints are optional - only add them if your vendor has production line limitations</li>
                                        <li>Each constraint represents a specific limitation (e.g., "Lines 1-2 can only make Products A &amp; B")</li>
                                        <li>Constraints can overlap - the system checks ALL of them plus the total capacity</li>
                                        <li>Example: Constraint 1 (4 TEU) + Constraint 2 (4 TEU) = 8 TEU, but total might be 10 TEU</li>
                                    </ul>
                                </div>
                            </page>
                            
                            <page string="Notes" name="notes">
                                <field name="notes" placeholder="e.g., 'Increased capacity due to new production line installation in Q1 2025'"/>
                            </page>
                        </notebook>
                        
                    </sheet>
                    
                </form>
            </field>
        </record>
        
        <!-- Search View -->
        <record id="view_dm_vendor_capacity_search" model="ir.ui.view">
            <field name="name">dm.vendor.capacity.search</field>
            <field name="model">dm.vendor.capacity</field>
            <field name="arch" type="xml">
                <search string="Vendor Capacity">
                    <field name="vendor_id"/>
                    <field name="valid_from"/>
                    <field name="valid_to"/>
                    
                    <filter name="current" string="Current" 
                            domain="[('is_current', '=', True)]"/>
                    <filter name="future" string="Future" 
                            domain="[('is_future', '=', True)]"/>
                    <filter name="expired" string="Expired" 
                            domain="[('is_expired', '=', True)]"/>
                    
                    <separator/>
                    <filter name="active" string="Active" 
                            domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Inactive" 
                            domain="[('active', '=', False)]"/>
                    
                    <group expand="0" string="Group By">
                        <filter name="group_vendor" string="Vendor" 
                                context="{'group_by': 'vendor_id'}"/>
                        <filter name="group_status" string="Status" 
                                context="{'group_by': 'status_badge'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_dm_vendor_capacity" model="ir.actions.act_window">
            <field name="name">Vendor Capacity</field>
            <field name="res_model">dm.vendor.capacity</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_current': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first vendor capacity record
                </p>
                <p>
                    Track vendor production capacity over time.<br/>
                    Define how many containers (or TEU) each vendor can produce per month.
                </p>
            </field>
        </record>
        
    </data>
</odoo>
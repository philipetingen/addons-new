<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ================================================================== -->
        <!-- CAPACITY PLANNING MENU STRUCTURE                                   -->
        <!-- ================================================================== -->
        
        <!-- Main Menu: Capacity Planning -->
        <menuitem id="menu_capacity_planning_root"
                  name="Capacity Planning"
                  sequence="50"
                  groups="dm_deal.group_dm_deal_user,dm_deal.group_dm_deal_manager"
                  web_icon="dm_capacity_planning,static/description/icon.png"/>
        
        <!-- ================================================================== -->
        <!-- SUBMENU: Planning                                                  -->
        <!-- ================================================================== -->
        
        <menuitem id="menu_capacity_planning_planning"
                  name="Planning"
                  parent="menu_capacity_planning_root"
                  sequence="5"/>
        
        <!-- Phase 3: Allocation Board -->
        <menuitem id="menu_production_allocation_board"
                  name="Allocation Board"
                  parent="menu_capacity_planning_planning"
                  action="action_production_allocation_board"
                  sequence="10"/>
        
        <!-- ================================================================== -->
        <!-- SUBMENU: Vendor Capacity                                           -->
        <!-- ================================================================== -->
        
        <menuitem id="menu_capacity_planning_capacity"
                  name="Vendor Capacity"
                  parent="menu_capacity_planning_root"
                  sequence="10"/>
        
        <!-- Vendor Capacity Records -->
        <menuitem id="menu_dm_vendor_capacity"
                  name="Capacity Records"
                  parent="menu_capacity_planning_capacity"
                  action="action_dm_vendor_capacity"
                  sequence="10"/>
        
        <!-- Capacity Constraints -->
        <menuitem id="menu_dm_vendor_capacity_constraint"
                  name="Capacity Constraints"
                  parent="menu_capacity_planning_capacity"
                  action="action_dm_vendor_capacity_constraint"
                  sequence="20"/>
        
        <!-- ================================================================== -->
        <!-- SUBMENU: Analysis & Reports                                        -->
        <!-- ================================================================== -->
        
        <menuitem id="menu_capacity_planning_analysis"
                  name="Analysis"
                  parent="menu_capacity_planning_root"
                  sequence="20"/>
        
        <!-- Phase 2: Action for Pivot View (By Vendor) -->
        <record id="action_capacity_analysis_by_vendor" model="ir.actions.act_window">
            <field name="name">Capacity by Vendor</field>
            <field name="res_model">dm.production.run</field>
            <field name="view_mode">pivot,graph,tree,form</field>
            <field name="view_id" ref="view_dm_production_run_pivot_capacity"/>
            <field name="context">{'group_by': ['supplier_id', 'rts_date:month']}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No production runs to analyze
                </p>
                <p>
                    This pivot view shows capacity utilization by vendor and month.
                </p>
            </field>
        </record>
        
        <!-- Phase 2: Action for Graph View (Timeline) -->
        <record id="action_capacity_analysis_timeline" model="ir.actions.act_window">
            <field name="name">Capacity Timeline</field>
            <field name="res_model">dm.production.run</field>
            <field name="view_mode">graph,pivot,tree,form</field>
            <field name="view_id" ref="view_dm_production_run_graph_capacity"/>
            <field name="context">{'group_by': ['rts_date:month']}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No production runs to analyze
                </p>
                <p>
                    This graph shows capacity usage over time.
                </p>
            </field>
        </record>
        
        <!-- Menu: Capacity by Vendor (Pivot) -->
        <menuitem id="menu_capacity_analysis_vendor"
                  name="By Vendor"
                  parent="menu_capacity_planning_analysis"
                  action="action_capacity_analysis_by_vendor"
                  sequence="10"/>
        
        <!-- Menu: Capacity Timeline (Graph) -->
        <menuitem id="menu_capacity_analysis_timeline"
                  name="Timeline"
                  parent="menu_capacity_planning_analysis"
                  action="action_capacity_analysis_timeline"
                  sequence="20"/>
        
    </data>
</odoo>
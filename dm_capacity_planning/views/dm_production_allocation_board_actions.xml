<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ================================================================== -->
        <!-- PRODUCTION ALLOCATION BOARD ACTIONS                                -->
        <!-- ================================================================== -->
        
        <!-- Action: Quick Allocate Wizard -->
        <record id="action_production_quick_allocate_wizard" model="ir.actions.act_window">
            <field name="name">Allocate to Production</field>
            <field name="res_model">dm.production.quick.allocate.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <!-- Action: Open Allocation Board -->
        <record id="action_production_allocation_board" model="ir.actions.act_window">
            <field name="name">Production Allocation Board</field>
            <field name="res_model">dm.production.allocation.board</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Production Allocation Board
                </p>
                <p>
                    Visual board for allocating unallocated deals to production runs.<br/>
                    Shows capacity utilization and prevents over-allocation.
                </p>
            </field>
        </record>
        
    </data>
</odoo>
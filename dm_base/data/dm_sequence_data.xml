<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Deal Sequence -->
        <record id="seq_dm_deal" model="ir.sequence">
            <field name="name">DM Deal</field>
            <field name="code">dm.deal</field>
            <field name="prefix">DM-%(year)s-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
            <field name="implementation">standard</field>
        </record>
        
        <!-- Production Run Sequence -->
        <record id="seq_dm_production_run" model="ir.sequence">
            <field name="name">DM Production Run</field>
            <field name="code">dm.production.run</field>
            <field name="prefix">PR-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
            <field name="implementation">standard</field>
        </record>
        
        <!-- Shipment Sequence -->
        <record id="seq_dm_shipment" model="ir.sequence">
            <field name="name">DM Shipment</field>
            <field name="code">dm.shipment</field>
            <field name="prefix">SH-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
            <field name="implementation">standard</field>
        </record>
        
        <!-- Container Sequence -->
        <record id="seq_dm_container" model="ir.sequence">
            <field name="name">DM Container</field>
            <field name="code">dm.container</field>
            <field name="prefix">CNT-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
            <field name="implementation">standard</field>
        </record>
        
        <!-- Document Sequence -->
        <record id="seq_dm_document" model="ir.sequence">
            <field name="name">DM Document</field>
            <field name="code">dm.document</field>
            <field name="prefix">DOC-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
            <field name="implementation">standard</field>
        </record>
        
        <!-- Allocation Sequence -->
        <record id="seq_dm_allocation" model="ir.sequence">
            <field name="name">DM Allocation</field>
            <field name="code">dm.allocation</field>
            <field name="prefix">ALLOC-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
            <field name="implementation">standard</field>
        </record>
        
    </data>
</odoo>
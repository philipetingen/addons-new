<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Standard Payment Milestones aligned with DonnaMello operations -->
        
        <!-- Order Confirmation Milestone -->
        <record id="milestone_order_conf" model="dm.payment.milestone">
            <field name="name">Order Confirmation</field>
            <field name="milestone_code">order_conf</field>
            <field name="sequence">10</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">True</field>
            <field name="typical_days_from_order">0</field>
            <field name="deal_date_field">confirmation_date</field>
            <field name="milestone_type">order</field>
            <field name="default_timing">on</field>
            <field name="default_days">0</field>
            <field name="description">Deal confirmed and purchase/sales orders created. Typical trigger for customer downpayment (20%).</field>
        </record>
        
        <!-- Production Start Milestone -->
        <record id="milestone_prod_start" model="dm.payment.milestone">
            <field name="name">Production Start</field>
            <field name="milestone_code">prod_start</field>
            <field name="sequence">20</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">False</field>
            <field name="typical_days_from_order">7</field>
            <field name="deal_date_field">production_start</field>
            <field name="primary_date_field">production_start_actual</field>
            <field name="fallback_date_field">production_start_current</field>
            <field name="milestone_type">production</field>
            <field name="default_timing">before</field>
            <field name="default_days">7</field>
            <field name="description">Production commenced at factory. Often used for supplier milestone payments.</field>
        </record>
        
        <!-- Ready to Ship Milestone -->
        <record id="milestone_rts" model="dm.payment.milestone">
            <field name="name">Ready to Ship</field>
            <field name="milestone_code">rts</field>
            <field name="sequence">30</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">True</field>
            <field name="typical_days_from_order">30</field>
            <field name="deal_date_field">rts</field>
            <field name="primary_date_field">rts_actual</field>
            <field name="fallback_date_field">rts_current</field>
            <field name="milestone_type">production</field>
            <field name="default_timing">before</field>
            <field name="default_days">14</field>
            <field name="description">Production complete and goods ready for shipment. Common trigger for supplier downpayment (14 days before).</field>
        </record>
        
        <!-- Quality Control Milestone -->
        <record id="milestone_qc" model="dm.payment.milestone">
            <field name="name">Quality Control Passed</field>
            <field name="milestone_code">qc</field>
            <field name="sequence">35</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">False</field>
            <field name="typical_days_from_order">32</field>
            <field name="milestone_type">production</field>
            <field name="default_timing">on</field>
            <field name="default_days">0</field>
            <field name="description">Quality control documentation complete. May trigger payment release in some contracts.</field>
        </record>
        
        <!-- Loading at Factory Milestone -->
        <record id="milestone_loading" model="dm.payment.milestone">
            <field name="name">Loading at Factory</field>
            <field name="milestone_code">loading</field>
            <field name="sequence">38</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">False</field>
            <field name="typical_days_from_order">34</field>
            <field name="deal_date_field">loading_date</field>
            <field name="primary_date_field">loading_date_actual</field>
            <field name="fallback_date_field">loading_date_current</field>
            <field name="milestone_type">shipping</field>
            <field name="default_timing">on</field>
            <field name="default_days">0</field>
            <field name="requires_confirmation">True</field>
            <field name="description">Goods loaded into containers. Triggers invoice generation with actual quantities.</field>
        </record>
        
        <!-- ETD (Shipment Departure) Milestone -->
        <record id="milestone_etd" model="dm.payment.milestone">
            <field name="name">Shipment Departed (ETD)</field>
            <field name="milestone_code">etd</field>
            <field name="sequence">40</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">True</field>
            <field name="typical_days_from_order">35</field>
            <field name="deal_date_field">etd</field>
            <field name="primary_date_field">etd_actual</field>
            <field name="fallback_date_field">etd_current</field>
            <field name="milestone_type">shipping</field>
            <field name="default_timing">on</field>
            <field name="default_days">0</field>
            <field name="description">Vessel departed from port of loading. Goods in transit.</field>
        </record>
        
        <!-- Bill of Lading Release Milestone -->
        <record id="milestone_bol_release" model="dm.payment.milestone">
            <field name="name">Bill of Lading Released</field>
            <field name="milestone_code">bol_release</field>
            <field name="sequence">45</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">False</field>
            <field name="typical_days_from_order">36</field>
            <field name="milestone_type">document</field>
            <field name="default_timing">on</field>
            <field name="default_days">0</field>
            <field name="blocking_milestone">True</field>
            <field name="description">BOL telex release confirmed. Often required before final payment.</field>
        </record>
        
        <!-- ETA (Estimated Time of Arrival) Milestone -->
        <record id="milestone_eta" model="dm.payment.milestone">
            <field name="name">Estimated Time of Arrival (ETA)</field>
            <field name="milestone_code">eta</field>
            <field name="sequence">50</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">True</field>
            <field name="typical_days_from_order">56</field>
            <field name="deal_date_field">eta</field>
            <field name="primary_date_field">eta_actual</field>
            <field name="fallback_date_field">eta_current</field>
            <field name="milestone_type">shipping</field>
            <field name="default_timing">before</field>
            <field name="default_days">7</field>
            <field name="description">Vessel arrival at destination port. Common trigger for balance payment (7 days before for customers, 3 days before for suppliers).</field>
        </record>
        
        <!-- Delivery Confirmation Milestone -->
        <record id="milestone_delivery" model="dm.payment.milestone">
            <field name="name">Delivery to Customer</field>
            <field name="milestone_code">delivery</field>
            <field name="sequence">60</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">True</field>
            <field name="typical_days_from_order">60</field>
            <field name="deal_date_field">delivery_date</field>
            <field name="milestone_type">delivery</field>
            <field name="default_timing">on</field>
            <field name="default_days">0</field>
            <field name="requires_confirmation">True</field>
            <field name="description">Goods delivered to customer warehouse. Final payment trigger for some terms.</field>
        </record>
        
        <!-- Invoice Date Milestone -->
        <record id="milestone_invoice_date" model="dm.payment.milestone">
            <field name="name">Invoice Date</field>
            <field name="milestone_code">invoice_date</field>
            <field name="sequence">70</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">False</field>
            <field name="typical_days_from_order">0</field>
            <field name="milestone_type">document</field>
            <field name="default_timing">after</field>
            <field name="default_days">0</field>
            <field name="description">Invoice generation date. Used for standard net payment terms (e.g., Net 30).</field>
        </record>
        
        <!-- Additional Milestone for Letter of Credit -->
        <record id="milestone_lc_confirmation" model="dm.payment.milestone">
            <field name="name">LC Confirmation</field>
            <field name="milestone_code">lc_confirm</field>
            <field name="sequence">15</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">False</field>
            <field name="typical_days_from_order">3</field>
            <field name="milestone_type">document</field>
            <field name="default_timing">on</field>
            <field name="default_days">0</field>
            <field name="description">Letter of Credit confirmed by bank. Required before production start for LC terms.</field>
        </record>
        
        <!-- Milestone for Document Submission -->
        <record id="milestone_docs_submitted" model="dm.payment.milestone">
            <field name="name">Documents Submitted</field>
            <field name="milestone_code">docs_submitted</field>
            <field name="sequence">55</field>
            <field name="active">True</field>
            <field name="is_payment_trigger">True</field>
            <field name="is_customer_visible">False</field>
            <field name="typical_days_from_order">58</field>
            <field name="milestone_type">document</field>
            <field name="default_timing">on</field>
            <field name="default_days">0</field>
            <field name="description">All shipping documents submitted to bank/customer. Triggers payment under CAD terms.</field>
        </record>
        
    </data>
    
    <!-- Standard Payment Terms with Milestones (as demo data) -->
    <data noupdate="0">
        
        <!-- Sales Payment Term: 20% DP at Order, 80% 7 days before ETA -->
        <record id="payment_term_sales_standard" model="account.payment.term">
            <field name="name">Sales: 20% Order, 80% Before ETA</field>
            <field name="is_cad_compliant">True</field>
            <field name="cad_term_type">dp_balance</field>
            <field name="use_milestone_payments">True</field>
            <field name="usage_context">sales</field>
            <field name="max_payment_days">60</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="payment_term_sales_standard_line1" model="account.payment.term.line">
            <field name="payment_id" ref="payment_term_sales_standard"/>
            <field name="sequence">10</field>
            <field name="value">percent</field>
            <field name="value_amount">20.0</field>
            <field name="milestone_mode">milestone</field>
            <field name="milestone_id" ref="milestone_order_conf"/>
            <field name="milestone_timing">on</field>
            <field name="milestone_days">0</field>
            <field name="is_downpayment">True</field>
            <field name="payment_context">sales</field>
        </record>
        
        <record id="payment_term_sales_standard_line2" model="account.payment.term.line">
            <field name="payment_id" ref="payment_term_sales_standard"/>
            <field name="sequence">20</field>
            <field name="value">percent</field>
            <field name="value_amount">80.0</field>
            <field name="milestone_mode">milestone</field>
            <field name="milestone_id" ref="milestone_eta"/>
            <field name="milestone_timing">before</field>
            <field name="milestone_days">7</field>
            <field name="requires_bol_release">True</field>
            <field name="payment_context">sales</field>
        </record>
        
        <!-- Purchase Payment Term: 20% DP 14 days before RTS, 80% 3 days before ETA -->
        <record id="payment_term_purchase_standard" model="account.payment.term">
            <field name="name">Purchase: 20% Before RTS, 80% Before ETA</field>
            <field name="is_cad_compliant">True</field>
            <field name="cad_term_type">dp_balance</field>
            <field name="use_milestone_payments">True</field>
            <field name="usage_context">purchase</field>
            <field name="max_payment_days">60</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="payment_term_purchase_standard_line1" model="account.payment.term.line">
            <field name="payment_id" ref="payment_term_purchase_standard"/>
            <field name="sequence">10</field>
            <field name="value">percent</field>
            <field name="value_amount">20.0</field>
            <field name="milestone_mode">milestone</field>
            <field name="milestone_id" ref="milestone_rts"/>
            <field name="milestone_timing">before</field>
            <field name="milestone_days">14</field>
            <field name="is_downpayment">True</field>
            <field name="payment_context">purchase</field>
        </record>
        
        <record id="payment_term_purchase_standard_line2" model="account.payment.term.line">
            <field name="payment_id" ref="payment_term_purchase_standard"/>
            <field name="sequence">20</field>
            <field name="value">percent</field>
            <field name="value_amount">80.0</field>
            <field name="milestone_mode">milestone</field>
            <field name="milestone_id" ref="milestone_eta"/>
            <field name="milestone_timing">before</field>
            <field name="milestone_days">3</field>
            <field name="payment_context">purchase</field>
        </record>
        
        <!-- 100% Before ETA Payment Term -->
        <record id="payment_term_100_eta" model="account.payment.term">
            <field name="name">100% 7 Days Before ETA</field>
            <field name="is_cad_compliant">True</field>
            <field name="cad_term_type">cod</field>
            <field name="use_milestone_payments">True</field>
            <field name="usage_context">both</field>
            <field name="max_payment_days">60</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="payment_term_100_eta_line" model="account.payment.term.line">
            <field name="payment_id" ref="payment_term_100_eta"/>
            <field name="sequence">10</field>
            <field name="value">percent</field>
            <field name="value_amount">100.0</field>
            <field name="milestone_mode">milestone</field>
            <field name="milestone_id" ref="milestone_eta"/>
            <field name="milestone_timing">before</field>
            <field name="milestone_days">7</field>
            <field name="requires_bol_release">True</field>
            <field name="payment_context">both</field>
        </record>
        
    </data>
</odoo>
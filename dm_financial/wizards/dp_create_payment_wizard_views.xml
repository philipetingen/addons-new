<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- CREATE PAYMENT WIZARD - FORM VIEW -->
    <!-- ============================================================ -->

    <record id="dp_create_payment_wizard_view_form" model="ir.ui.view">
        <field name="name">dm.dp.create.payment.wizard.form</field>
        <field name="model">dm.dp.create.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Payment from DP Requests">
                <!-- Hidden fields for modifiers -->
                <field name="show_amount_warning" invisible="1"/>
                <field name="dp_request_ids" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="payment_type" invisible="1"/>
                
                <group>
                    <group string="DP Requests" colspan="2">
                        <field name="dp_count" string="Selected Requests"/>
                        <field name="dp_display" widget="text" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                </group>

                <group>
                    <!-- Left: From DPs (readonly) -->
                    <group string="From Selected DPs">
                        <field name="partner_id" readonly="1"/>
                        <field name="currency_id" readonly="1" groups="base.group_multi_currency"/>
                        <field name="payment_type_label" string="Type" readonly="1"/>
                        <field name="total_dp_amount" string="Total DP Amount" readonly="1"/>
                    </group>

                    <!-- Right: Payment details (editable) -->
                    <group string="Payment Details">
                        <field name="journal_id" 
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="payment_date"/>
                        <field name="amount"/>
                        <field name="memo" placeholder="Auto-generated from DP names"/>
                    </group>
                </group>

                <!-- Amount warning -->
                <group invisible="not show_amount_warning">
                    <div class="alert alert-warning" role="alert" colspan="2">
                        <field name="warning_message" nolabel="1" readonly="1"/>
                        <br/>
                        <small class="text-muted">
                            Difference: <field name="amount_difference" nolabel="1" class="oe_inline"/> 
                            <field name="currency_id" nolabel="1" class="oe_inline" options="{'no_open': True}"/>
                        </small>
                    </div>
                </group>

                <footer>
                    <button name="action_create_payment" 
                            string="Create Payment" 
                            type="object" 
                            class="btn-primary"
                            icon="fa-money"/>
                    <button name="action_cancel" 
                            string="Cancel" 
                            type="object" 
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- CREATE PAYMENT WIZARD - ACTION -->
    <!-- ============================================================ -->

    <record id="dp_create_payment_wizard_action" model="ir.actions.act_window">
        <field name="name">Create Payment</field>
        <field name="res_model">dm.dp.create.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
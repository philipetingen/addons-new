<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Cash Flow Projection Wizard Form View -->
    <record id="view_dm_cash_flow_projection_wizard_form" model="ir.ui.view">
        <field name="name">dm.cash.flow.projection.wizard.form</field>
        <field name="model">dm.cash.flow.projection.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Cash Flow Projection">
                <group>
                    <group string="Projection Scope">
                        <field name="projection_type" widget="radio"/>
                        <field name="deal_id" 
                               invisible="projection_type != 'single'"
                               required="projection_type == 'single'"
                               options="{'no_create': True}"/>
                        <field name="deal_ids" widget="many2many_tags"
                               invisible="projection_type != 'multiple'"
                               required="projection_type == 'multiple'"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                
                <group invisible="projection_type != 'date_range'">
                    <group string="Deal Selection Criteria">
                        <field name="filter_by_confirmation"/>
                        <field name="filter_by_rts"/>
                        <field name="filter_by_eta"/>
                    </group>
                </group>
                
                <separator string="Projection Settings"/>
                <group>
                    <group string="Projection Method">
                        <field name="projection_method" widget="radio"/>
                        <field name="clear_existing"/>
                    </group>
                    <group string="Include Components">
                        <field name="include_downpayments"/>
                        <field name="include_balance_payments"/>
                        <field name="include_freight_insurance"/>
                    </group>
                </group>
                
                <separator string="Manual Milestones" invisible="projection_method != 'manual'"/>
                <field name="manual_milestone_ids" nolabel="1" 
                       invisible="projection_method != 'manual'">
                    <tree editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="description"/>
                        <field name="flow_type"/>
                        <field name="date_type"/>
                        <field name="fixed_date" 
                               invisible="date_type != 'fixed'"
                               required="date_type == 'fixed'"/>
                        <field name="days_offset" 
                               invisible="date_type == 'fixed'"
                               required="date_type != 'fixed'"/>
                        <field name="amount_type"/>
                        <field name="percentage" 
                               invisible="amount_type != 'percentage'"
                               required="amount_type == 'percentage'"/>
                        <field name="fixed_amount" 
                               invisible="amount_type != 'fixed'"
                               required="amount_type == 'fixed'"/>
                    </tree>
                </field>
                
                <separator string="Projection Summary"/>
                <group>
                    <group>
                        <field name="deal_count" readonly="1"/>
                        <field name="total_inflow" readonly="1" widget="monetary"/>
                    </group>
                    <group>
                        <field name="total_outflow" readonly="1" widget="monetary"/>
                        <field name="net_cash_flow" readonly="1" widget="monetary"
                               decoration-success="net_cash_flow &gt; 0"
                               decoration-danger="net_cash_flow &lt; 0"/>
                    </group>
                </group>
                
                <footer>
                    <button name="action_generate_projection" type="object" 
                            string="Generate Projection" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action for Cash Flow Projection Wizard from Menu -->
    <record id="action_dm_cash_flow_projection_wizard" model="ir.actions.act_window">
        <field name="name">Generate Cash Flow Projection</field>
        <field name="res_model">dm.cash.flow.projection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <!-- Action for Cash Flow Projection from Deal -->
    <record id="action_dm_cash_flow_projection_wizard_from_deal" model="ir.actions.act_window">
        <field name="name">Generate Cash Flow Projection</field>
        <field name="res_model">dm.cash.flow.projection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="dm_deal.model_dm_deal"/>
        <field name="binding_view_types">form</field>
        <field name="context">{'default_projection_type': 'single', 'default_deal_id': active_id}</field>
    </record>
    
    <!-- Server Action for Batch Cash Flow Generation -->
    <record id="action_server_generate_cash_flow_batch" model="ir.actions.server">
        <field name="name">Generate Cash Flow Projections</field>
        <field name="model_id" ref="dm_deal.model_dm_deal"/>
        <field name="binding_model_id" ref="dm_deal.model_dm_deal"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Generate Cash Flow Projection',
        'res_model': 'dm.cash.flow.projection.wizard',
        'view_mode': 'form',
        'target': 'new',
        'context': {
            'default_projection_type': 'multiple',
            'default_deal_ids': [(6, 0, records.ids)]
        }
    }
        </field>
    </record>
    
    <!-- Add to Financial Menu -->
    <menuitem id="menu_dm_cash_flow_projection_wizard" 
              name="Generate Projections" 
              parent="dm_financial.menu_dm_cash_flow"
              action="action_dm_cash_flow_projection_wizard"
              sequence="20"/>
    
</odoo>
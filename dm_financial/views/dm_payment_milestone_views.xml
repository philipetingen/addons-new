<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_dm_payment_milestone_tree" model="ir.ui.view">
        <field name="name">dm.payment.milestone.tree</field>
        <field name="model">dm.payment.milestone</field>
        <field name="arch" type="xml">
            <tree string="Payment Milestones">
                <field name="name"/>
                <field name="deal_id"/>
                <field name="milestone_type_id"/>
                <field name="payment_type"/>
                <field name="sequence"/>
                <field name="percentage"/>
                <field name="amount" widget="monetary"/>
                <field name="amount_paid" widget="monetary"/>
                <field name="amount_remaining" widget="monetary"/>
                <field name="due_date"/>
                <field name="state"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dm_payment_milestone_form" model="ir.ui.view">
        <field name="name">dm.payment.milestone.form</field>
        <field name="model">dm.payment.milestone</field>
        <field name="arch" type="xml">
            <form string="Payment Milestone">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,due,requested,paid"/>
                    <button name="action_create_downpayment" 
                            type="object" 
                            string="Create Downpayment" 
                            class="btn-primary"
                            invisible="state in ['paid', 'cancelled']"/>
                </header>
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="deal_id"/>
                            <field name="milestone_type_id" required="1"/>
                            <field name="payment_type"/>
                            <field name="sequence"/>
                            <field name="name"/>
                        </group>
                        <group string="Amounts">
                            <field name="percentage"/>
                            <field name="fixed_amount"/>
                            <field name="amount" widget="monetary"/>
                            <field name="amount_paid" widget="monetary"/>
                            <field name="amount_remaining" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates &amp; Timing">
                            <field name="milestone_date"/>
                            <field name="timing"/>
                            <field name="days_offset"/>
                            <field name="due_date"/>
                        </group>
                        <group string="Partner">
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Downpayments">
                            <field name="downpayment_request_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="amount_requested"/>
                                    <field name="amount_received"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                            <group>
                                <field name="downpayment_count" invisible="1"/>
                                <button name="action_view_downpayments" 
                                        type="object" 
                                        string="View All Downpayments"
                                        class="btn-link"
                                        invisible="downpayment_count == 0"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_dm_payment_milestone_kanban" model="ir.ui.view">
        <field name="name">dm.payment.milestone.kanban</field>
        <field name="model">dm.payment.milestone</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="deal_id"/>
                <field name="payment_type"/>
                <field name="amount"/>
                <field name="amount_remaining"/>
                <field name="due_date"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="deal_id"/>
                                </div>
                                <div>
                                    <span>Due: </span>
                                    <field name="due_date"/>
                                </div>
                                <div>
                                    <field name="currency_id" invisible="1"/>
                                    <span>Amount: </span>
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                                <div t-if="record.amount_remaining.raw_value &gt; 0">
                                    <span class="text-danger">Remaining: </span>
                                    <field name="amount_remaining" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_dm_payment_milestone_search" model="ir.ui.view">
        <field name="name">dm.payment.milestone.search</field>
        <field name="model">dm.payment.milestone</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="deal_id"/>
                <field name="partner_id"/>
                <field name="milestone_type_id"/>
                
                <filter string="Customer" name="customer" domain="[('payment_type', '=', 'customer')]"/>
                <filter string="Supplier" name="supplier" domain="[('payment_type', '=', 'supplier')]"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Due" name="due" domain="[('state', '=', 'due')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Deal" name="group_deal" context="{'group_by': 'deal_id'}"/>
                    <filter string="Payment Type" name="group_type" context="{'group_by': 'payment_type'}"/>
                    <filter string="Milestone Type" name="group_milestone" context="{'group_by': 'milestone_type_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Due Date" name="group_due_date" context="{'group_by': 'due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dm_payment_milestone" model="ir.actions.act_window">
        <field name="name">Payment Milestones</field>
        <field name="res_model">dm.payment.milestone</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_dm_payment_milestone_search"/>
        <field name="context">{'group_by': 'state'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No payment milestones found
            </p>
            <p>
                Payment milestones are typically created automatically from deals based on payment terms.
            </p>
        </field>
    </record>
 
</odoo>
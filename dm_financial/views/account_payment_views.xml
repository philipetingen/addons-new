<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- ACCOUNT PAYMENT - FORM VIEW EXTENSION -->
    <!-- ============================================================ -->

    <record id="view_account_payment_form_dm_financial" model="ir.ui.view">
        <field name="name">account.payment.form.dm_financial</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            
            <!-- Add smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- DP Requests smart button -->
                <button name="action_view_dp_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list-alt"
                        invisible="dp_request_count == 0">
                    <field name="dp_request_count" widget="statinfo" string="DP Requests"/>
                </button>
                
                <!-- Related Deals smart button -->
                <button name="action_view_deals"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-handshake-o"
                        invisible="dm_deal_count == 0">
                    <field name="dm_deal_count" widget="statinfo" string="Deals"/>
                </button>
            </xpath>

            <!-- Add hidden fields for modifiers -->
            <xpath expr="//sheet" position="before">
                <field name="has_dp_requests" invisible="1"/>
                <field name="dp_request_count" invisible="1"/>
                <field name="dm_deal_count" invisible="1"/>
            </xpath>

            <!-- Add Assign DP Requests button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_assign_dp_requests"
                        string="Assign DP Requests"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'draft'"
                        icon="fa-link"/>
            </xpath>

            <!-- Add DP Requests notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="DP Requests" name="dp_requests"
                      invisible="dp_request_count == 0">
                    
                    <!-- Summary at top -->
                    <group>
                        <group>
                            <field name="dp_total_amount" string="Total DP Amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="dp_amount_difference" string="Difference" readonly="1"
                                   decoration-danger="dp_amount_difference &lt; 0"
                                   decoration-warning="dp_amount_difference &gt; 0"
                                   decoration-success="dp_amount_difference == 0"/>
                        </group>
                    </group>
                    
                    <field name="dp_request_ids" readonly="1">
                        <tree string="Allocated DP Requests"
                              decoration-success="state == 'paid'"
                              decoration-warning="state == 'pending'">
                            <field name="name"/>
                            <field name="deal_id"/>
                            <field name="partner_id" column_invisible="1"/>
                            <field name="milestone_id"/>
                            <field name="due_date"/>
                            <field name="amount_requested" sum="Total Requested"/>
                            <field name="amount_received" sum="Total Received"/>
                            <field name="state" widget="badge"
                                   decoration-warning="state == 'pending'"
                                   decoration-success="state == 'paid'"/>
                            <field name="currency_id" column_invisible="1"/>
                        </tree>
                    </field>
                </page>
            </xpath>

            <!-- Add related deals field (hidden, for compute) -->
            <xpath expr="//sheet" position="inside">
                <field name="dm_deal_ids" invisible="1"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACCOUNT PAYMENT - TREE VIEW EXTENSION -->
    <!-- ============================================================ -->

    <record id="view_account_payment_tree_dm_financial" model="ir.ui.view">
        <field name="name">account.payment.tree.dm_financial</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            
            <!-- Add DP count column after state -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="dp_request_count" string="DPs" optional="show"/>
                <field name="dp_total_amount" string="DP Total" optional="hide"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACCOUNT PAYMENT - SEARCH VIEW EXTENSION -->
    <!-- ============================================================ -->

    <record id="view_account_payment_search_dm_financial" model="ir.ui.view">
        <field name="name">account.payment.search.dm_financial</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            
            <!-- Add DP-related filters -->
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="With DP Requests" name="filter_with_dp"
                        domain="[('has_dp_requests', '=', True)]"/>
                <filter string="Without DP Requests" name="filter_without_dp"
                        domain="[('has_dp_requests', '=', False)]"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- PAYMENTS WITH DP - DEDICATED ACTION -->
    <!-- ============================================================ -->

    <record id="action_account_payment_with_dp" model="ir.actions.act_window">
        <field name="name">Payments with DP Requests</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('has_dp_requests', '=', True)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No payments with DP requests
            </p>
            <p>
                This view shows payments that have DP requests allocated to them.
                Create payments from the DP Requests menu using the bulk action.
            </p>
        </field>
    </record>

</odoo>
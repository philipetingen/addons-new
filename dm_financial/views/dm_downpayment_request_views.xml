<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- TREE VIEW -->
    <!-- ============================================================ -->

    <record id="dm_downpayment_request_view_tree" model="ir.ui.view">
        <field name="name">dm.downpayment.request.tree</field>
        <field name="model">dm.downpayment.request</field>
        <field name="arch" type="xml">
            <tree string="Downpayment Requests"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'pending' and not is_allocated"
                  decoration-primary="state == 'pending' and is_allocated"
                  decoration-success="state == 'paid'"
                  decoration-muted="state == 'cancelled'"
                  multi_edit="1">
                
                <!-- Hidden fields for decorations -->
                <field name="is_allocated" column_invisible="1"/>
                
                <field name="name" decoration-bf="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="deal_id"/>
                <field name="subdeal_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="milestone_id"/>
                <field name="payment_type" widget="badge"
                       decoration-success="payment_type == 'inbound'"
                       decoration-info="payment_type == 'outbound'"/>
                <field name="due_date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_requested" sum="Total Requested"/>
                <field name="amount_received" sum="Total Received" optional="show"/>
                <field name="amount_remaining" sum="Total Remaining" optional="show"/>
                
                <!-- Payment linkage columns -->
                <field name="payment_id" optional="show"/>
                <field name="payment_state" widget="badge" optional="show"
                       decoration-info="payment_state == 'draft'"
                       decoration-success="payment_state == 'posted'"
                       decoration-muted="payment_state == 'cancelled'"/>
                <field name="payment_date" optional="hide"/>
                
                <field name="company_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- FORM VIEW -->
    <!-- ============================================================ -->

    <record id="dm_downpayment_request_view_form" model="ir.ui.view">
        <field name="name">dm.downpayment.request.form</field>
        <field name="model">dm.downpayment.request</field>
        <field name="arch" type="xml">
            <form string="Downpayment Request">
                <!-- Hidden fields for modifiers -->
                <field name="is_allocated" invisible="1"/>
                <field name="payment_state" invisible="1"/>
                <field name="payment_id" invisible="1"/>
                <field name="percentage" invisible="1"/>
                <field name="invoice_ids" invisible="1"/>
                
                <header>
                    <!-- State transition buttons -->
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    
                    <!-- Payment actions - only when pending and not allocated -->
                    <button name="action_create_payment_wizard"
                            string="Create Payment"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'pending' or is_allocated"/>
                    
                    <!-- View payment - when allocated -->
                    <button name="action_view_payment"
                            string="View Payment"
                            type="object"
                            class="btn-secondary"
                            invisible="not is_allocated"
                            icon="fa-money"/>
                    
                    <!-- Deallocate - only when allocated to draft payment -->
                    <button name="action_deallocate"
                            string="Deallocate"
                            type="object"
                            class="btn-secondary"
                            invisible="not is_allocated or payment_state != 'draft'"
                            confirm="Remove this DP request from the linked payment?"/>
                    
                    <!-- Cancel -->
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'pending') or is_allocated"/>
                    
                    <!-- Reset to draft -->
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    
                    <!-- Status bar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,paid"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_deal"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-handshake-o"
                                invisible="not deal_id">
                            <field name="deal_id" widget="statinfo" string="Deal"/>
                        </button>
                        
                        <button name="action_view_payment"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money"
                                invisible="not is_allocated">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="payment_name"/>
                                </span>
                                <span class="o_stat_text">Payment</span>
                            </div>
                        </button>
                    </div>

                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="partner_id" 
                                   readonly="is_allocated"
                                   options="{'no_create': True}"/>
                        </h2>
                    </div>

                    <!-- Allocation warning banner -->
                    <div class="alert alert-info" role="alert"
                         invisible="not is_allocated or payment_state != 'draft'">
                        <strong>Allocated to draft payment.</strong>
                        This DP request is linked to payment 
                        <field name="payment_name" class="fw-bold"/>. 
                        Critical fields are locked. Post the payment to mark this DP as paid.
                    </div>
                    
                    <div class="alert alert-success" role="alert"
                         invisible="not is_allocated or payment_state != 'posted'">
                        <strong>Payment posted.</strong>
                        This DP request has been paid via 
                        <field name="payment_name" class="fw-bold"/>
                        on <field name="payment_date"/>.
                    </div>

                    <group>
                        <!-- Left column: Business references -->
                        <group string="Reference">
                            <field name="deal_id"
                                   readonly="is_allocated"
                                   options="{'no_create': True}"
                                   required="1"/>
                            <field name="subdeal_id"
                                   readonly="is_allocated"
                                   options="{'no_create': True}"/>
                            <field name="milestone_id"
                                   readonly="is_allocated"
                                   options="{'no_create': True}"/>
                            <field name="payment_term_id"
                                   readonly="1"
                                   invisible="not payment_term_id"/>
                        </group>

                        <!-- Right column: Classification -->
                        <group string="Classification">
                            <field name="payment_type"
                                   readonly="is_allocated"
                                   widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="currency_id"
                                   readonly="is_allocated"
                                   groups="base.group_multi_currency"/>
                            <field name="due_date"
                                   readonly="is_allocated"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <!-- Amounts -->
                        <group string="Amounts">
                            <field name="amount_requested"
                                   readonly="is_allocated"
                                   class="oe_inline"/>
                            <field name="percentage"
                                   readonly="is_allocated"
                                   invisible="percentage == 0"/>
                            <label for="amount_received"/>
                            <div class="o_row">
                                <field name="amount_received" class="oe_inline"/>
                                <span class="text-muted" invisible="not is_allocated">
                                    (from linked payment)
                                </span>
                            </div>
                            <field name="amount_remaining"
                                   decoration-danger="amount_remaining &gt; 0"
                                   decoration-success="amount_remaining &lt;= 0"/>
                        </group>

                        <!-- Payment linkage - only show when allocated -->
                        <group string="Payment" invisible="not is_allocated">
                            <field name="payment_id" readonly="1"/>
                            <field name="payment_state" widget="badge"
                                   decoration-info="payment_state == 'draft'"
                                   decoration-success="payment_state == 'posted'"
                                   decoration-muted="payment_state == 'cancelled'"/>
                            <field name="payment_date" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <!-- Order references -->
                        <group string="Related Orders">
                            <field name="sale_order_id"
                                   readonly="1"
                                   invisible="payment_type != 'inbound'"/>
                            <field name="purchase_order_id"
                                   readonly="1"
                                   invisible="payment_type != 'outbound'"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Notes tab -->
                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Add any notes or comments here..."/>
                        </page>

                        <!-- Applied invoices tab -->
                        <page string="Applied to Invoices" name="invoices"
                              invisible="not invoice_ids">
                            <field name="invoice_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SEARCH VIEW -->
    <!-- ============================================================ -->

    <record id="dm_downpayment_request_view_search" model="ir.ui.view">
        <field name="name">dm.downpayment.request.search</field>
        <field name="model">dm.downpayment.request</field>
        <field name="arch" type="xml">
            <search string="Search Downpayment Requests">
                <!-- Search fields -->
                <field name="name"/>
                <field name="partner_id"/>
                <field name="deal_id"/>
                <field name="subdeal_id"/>
                <field name="milestone_id"/>
                <field name="payment_id"/>
                
                <separator/>
                
                <!-- State filters -->
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Pending" name="filter_pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Paid" name="filter_paid"
                        domain="[('state', '=', 'paid')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                
                <separator/>
                
                <!-- Type filters -->
                <filter string="Customer (Inbound)" name="filter_customer"
                        domain="[('payment_type', '=', 'inbound')]"/>
                <filter string="Vendor (Outbound)" name="filter_vendor"
                        domain="[('payment_type', '=', 'outbound')]"/>
                
                <separator/>
                
                <!-- Allocation filters -->
                <filter string="Unallocated" name="filter_unallocated"
                        domain="[('is_allocated', '=', False), ('state', '=', 'pending')]"/>
                <filter string="Allocated - Draft Payment" name="filter_allocated_draft"
                        domain="[('is_allocated', '=', True), ('payment_state', '=', 'draft')]"/>
                <filter string="Allocated - Posted Payment" name="filter_allocated_posted"
                        domain="[('is_allocated', '=', True), ('payment_state', '=', 'posted')]"/>
                
                <separator/>
                
                <!-- Date filters - simplified for Odoo 17 -->
                <filter string="Overdue" name="filter_overdue"
                        domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', '=', 'pending')]"/>
                <filter string="Due Today" name="filter_due_today"
                        domain="[('due_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                
                <!-- Group by -->
                <group expand="0" string="Group By">
                    <filter string="State" name="groupby_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Partner" name="groupby_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Deal" name="groupby_deal"
                            context="{'group_by': 'deal_id'}"/>
                    <filter string="Subdeal" name="groupby_subdeal"
                            context="{'group_by': 'subdeal_id'}"/>
                    <filter string="Milestone" name="groupby_milestone"
                            context="{'group_by': 'milestone_id'}"/>
                    <filter string="Payment Type" name="groupby_payment_type"
                            context="{'group_by': 'payment_type'}"/>
                    <filter string="Payment" name="groupby_payment"
                            context="{'group_by': 'payment_id'}"/>
                    <filter string="Due Date" name="groupby_due_date"
                            context="{'group_by': 'due_date:month'}"/>
                    <filter string="Payment Status" name="groupby_payment_state"
                            context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SERVER ACTION: Bulk Create Payment -->
    <!-- ============================================================ -->

    <record id="action_dp_request_create_payment" model="ir.actions.server">
        <field name="name">Create Payment</field>
        <field name="model_id" ref="model_dm_downpayment_request"/>
        <field name="binding_model_id" ref="model_dm_downpayment_request"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_create_payment_wizard()
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- WINDOW ACTIONS -->
    <!-- ============================================================ -->

    <!-- Main action - all DP requests -->
    <record id="dm_downpayment_request_action" model="ir.actions.act_window">
        <field name="name">Downpayment Requests</field>
        <field name="res_model">dm.downpayment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="dm_downpayment_request_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No downpayment requests found
            </p>
            <p>
                Downpayment requests are created automatically from payment terms
                when deals or subdeals are confirmed, or can be created manually.
            </p>
        </field>
    </record>

    <!-- Customer DP requests -->
    <record id="dm_downpayment_request_action_customer" model="ir.actions.act_window">
        <field name="name">Customer Downpayments</field>
        <field name="res_model">dm.downpayment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="dm_downpayment_request_view_search"/>
        <field name="domain">[('payment_type', '=', 'inbound')]</field>
        <field name="context">{'default_payment_type': 'inbound', 'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customer downpayment requests
            </p>
            <p>
                Customer downpayments are receivables expected from customers
                based on milestone payment terms.
            </p>
        </field>
    </record>

    <!-- Vendor DP requests -->
    <record id="dm_downpayment_request_action_vendor" model="ir.actions.act_window">
        <field name="name">Vendor Downpayments</field>
        <field name="res_model">dm.downpayment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="dm_downpayment_request_view_search"/>
        <field name="domain">[('payment_type', '=', 'outbound')]</field>
        <field name="context">{'default_payment_type': 'outbound', 'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No vendor downpayment requests
            </p>
            <p>
                Vendor downpayments are payables due to suppliers
                based on milestone payment terms.
            </p>
        </field>
    </record>

    <!-- Unallocated pending - quick access -->
    <record id="dm_downpayment_request_action_unallocated" model="ir.actions.act_window">
        <field name="name">Pending Allocation</field>
        <field name="res_model">dm.downpayment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="dm_downpayment_request_view_search"/>
        <field name="domain">[('state', '=', 'pending'), ('is_allocated', '=', False)]</field>
        <field name="context">{'search_default_groupby_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                All pending requests are allocated!
            </p>
            <p>
                This view shows pending DP requests that are not yet
                linked to a payment document. Select multiple requests
                and use Actions → Create Payment to bulk create payments.
            </p>
        </field>
    </record>

</odoo>
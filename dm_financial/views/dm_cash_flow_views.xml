<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Tree View -->
    <record id="view_dm_cash_flow_tree" model="ir.ui.view">
        <field name="name">dm.cash.flow.tree</field>
        <field name="model">dm.cash_flow</field>
        <field name="arch" type="xml">
            <tree string="Cash Flow Projection" 
                  decoration-success="type == 'inflow' and status == 'received'"
                  decoration-warning="status == 'confirmed'"
                  decoration-info="type == 'inflow'"
                  decoration-muted="status == 'cancelled'">
                <field name="date"/>
                <field name="deal_id"/>
                <field name="type"/>
                <field name="category"/>
                <field name="description"/>
                <field name="amount" widget="monetary" 
                       decoration-success="type == 'inflow'"
                       decoration-danger="type == 'outflow'"/>
                <field name="running_balance" widget="monetary"/>
                <field name="status" widget="badge"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_dm_cash_flow_form" model="ir.ui.view">
        <field name="name">dm.cash.flow.form</field>
        <field name="model">dm.cash_flow</field>
        <field name="arch" type="xml">
            <form string="Cash Flow Entry">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" 
                            class="oe_highlight" invisible="status != 'projected'"/>
                    <button name="action_mark_received" type="object" string="Mark Received/Paid"
                            invisible="status != 'confirmed'"/>
                    <field name="status" widget="statusbar" 
                           statusbar_visible="projected,confirmed,received"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Received" bg_color="bg-success" 
                            invisible="status != 'received' or type != 'inflow'"/>
                    <widget name="web_ribbon" title="Paid" bg_color="bg-warning" 
                            invisible="status != 'received' or type != 'outflow'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" 
                            invisible="status != 'cancelled'"/>
                    
                    <group>
                        <group string="Transaction Details">
                            <field name="date"/>
                            <field name="type"/>
                            <field name="category"/>
                            <field name="deal_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Amount">
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id"/>
                            <field name="running_balance" widget="monetary"/>
                        </group>
                    </group>
                    
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    
                    <group string="Related Documents">
                        <field name="invoice_id" readonly="1"
                               invisible="not invoice_id"/>
                        <field name="payment_id" readonly="1"
                               invisible="not payment_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Pivot View -->
    <record id="view_dm_cash_flow_pivot" model="ir.ui.view">
        <field name="name">dm.cash.flow.pivot</field>
        <field name="model">dm.cash_flow</field>
        <field name="arch" type="xml">
            <pivot string="Cash Flow Analysis">
                <field name="date" type="row" interval="month"/>
                <field name="type" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    
    <!-- Graph View -->
    <record id="view_dm_cash_flow_graph" model="ir.ui.view">
        <field name="name">dm.cash.flow.graph</field>
        <field name="model">dm.cash_flow</field>
        <field name="arch" type="xml">
            <graph string="Cash Flow Trend" type="line" stacked="0">
                <field name="date" type="row"/>
                <field name="amount" type="measure"/>
                <field name="type" type="col"/>
            </graph>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_dm_cash_flow_search" model="ir.ui.view">
        <field name="name">dm.cash.flow.search</field>
        <field name="model">dm.cash_flow</field>
        <field name="arch" type="xml">
            <search string="Search Cash Flow">
                <field name="deal_id"/>
                <field name="description"/>
                <separator/>
                <filter name="inflows" string="Inflows" domain="[('type', '=', 'inflow')]"/>
                <filter name="outflows" string="Outflows" domain="[('type', '=', 'outflow')]"/>
                <separator/>
                <filter name="projected" string="Projected" domain="[('status', '=', 'projected')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter name="received" string="Received/Paid" domain="[('status', '=', 'received')]"/>
                <separator/>
                <filter name="this_week" string="This Week" 
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                ('date', '&lt;', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="next_month" string="Next Month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01')),
                                ('date', '&lt;', (context_today() + relativedelta(months=2)).strftime('%Y-%m-01'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'type'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_deal" string="Deal" context="{'group_by': 'deal_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_dm_cash_flow" model="ir.actions.act_window">
        <field name="name">Cash Flow Projection</field>
        <field name="res_model">dm.cash_flow</field>
        <field name="view_mode">tree,graph,pivot,form</field>
        <field name="search_view_id" ref="view_dm_cash_flow_search"/>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Cash Flow Projections
            </p>
            <p>
                Cash flow projections are generated automatically from deals based on payment terms.
                They show expected inflows from customers and outflows to suppliers.
            </p>
        </field>
    </record>
    
</odoo>
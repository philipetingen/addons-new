<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_shipment_allocation_wizard_form" model="ir.ui.view">
        <field name="name">shipment.allocation.wizard.form</field>
        <field name="model">shipment.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocate Deals to Shipment">
                
                <!-- Step 1: Validation -->
                <group name="validation" invisible="not has_hard_errors and not has_soft_warnings">
                    <field name="has_hard_errors" invisible="1"/>
                    <field name="has_soft_warnings" invisible="1"/>
                    
                    <field name="hard_errors" widget="html" 
                           colspan="2"
                           invisible="not has_hard_errors"
                           nolabel="1"/>
                    
                    <field name="soft_warnings" widget="html" 
                           colspan="2"
                           invisible="not has_soft_warnings"
                           nolabel="1"/>
                </group>
                
                <separator string="Deals to Allocate"/>
                <field name="deal_ids" nolabel="1">
                    <tree>
                        <field name="name"/>
                        <field name="customer_po_number"/>
                        <field name="supplier_id"/>
                        <field name="loading_port_id"/>
                        <field name="discharge_port_id"/>
                        <field name="rts_current"/>
                        <field name="state" widget="badge"/>
                    </tree>
                </field>
                
                <!-- Step 2: Route Override -->
                <separator string="Route"/>
                <group name="route">
                    <field name="route_consistent" invisible="1"/>
                    <field name="use_route_override"/>
                    <field name="loading_port_id" 
                           invisible="not use_route_override"
                           required="use_route_override"/>
                    <field name="discharge_port_id" 
                           invisible="not use_route_override"
                           required="use_route_override"/>
                </group>
                
                <!-- Step 3: Date Strategy -->
                <separator string="Milestone Date Strategy"/>
                <group name="dates">
                    <field name="date_strategy"/>
                    <group invisible="date_strategy != 'manual'">
                        <field name="loading_date_manual" 
                               required="date_strategy == 'manual'"/>
                        <field name="etd_manual" 
                               required="date_strategy == 'manual'"/>
                        <field name="eta_manual" 
                               required="date_strategy == 'manual'"/>
                        <field name="delivery_manual"/>
                    </group>
                </group>
                
                <!-- Proposed dates - EDITABLE (Sprint B key feature) -->
                <separator string="Proposed Shipment Milestones"/>
                <div class="alert alert-info" role="alert">
                    <i class="fa fa-info-circle"/> Dates are calculated from the strategy above. 
                    You can adjust them before creating the shipment.
                </div>
                <group name="proposed" col="4">
                    <field name="proposed_loading" readonly="0"/>
                    <field name="proposed_etd" readonly="0"/>
                    <field name="proposed_eta" readonly="0"/>
                    <field name="proposed_delivery" readonly="0"/>
                </group>
                
                <!-- Date impact matrix -->
                <notebook>
                    <page string="Milestone Impact by Deal">
                        <field name="date_strategy_line_ids" nolabel="1">
                            <tree decoration-success="loading_impact == 'earlier' and etd_impact == 'earlier'"
                                  decoration-warning="loading_impact == 'later' or etd_impact == 'later'"
                                  decoration-muted="loading_impact == 'same' and etd_impact == 'same' and eta_impact == 'same' and delivery_impact == 'same'">
                                <field name="deal_id"/>
                                <field name="loading_current"/>
                                <field name="loading_proposed"/>
                                <field name="loading_impact" 
                                       widget="badge" 
                                       decoration-success="loading_impact == 'earlier'"
                                       decoration-info="loading_impact == 'new'"
                                       decoration-danger="loading_impact == 'later'"/>
                                <field name="etd_current"/>
                                <field name="etd_proposed"/>
                                <field name="etd_impact" 
                                       widget="badge"
                                       decoration-success="etd_impact == 'earlier'"
                                       decoration-info="etd_impact == 'new'"
                                       decoration-danger="etd_impact == 'later'"/>
                                <field name="eta_current"/>
                                <field name="eta_proposed"/>
                                <field name="eta_impact" 
                                       widget="badge"
                                       decoration-success="eta_impact == 'earlier'"
                                       decoration-info="eta_impact == 'new'"
                                       decoration-danger="eta_impact == 'later'"/>
                                <field name="delivery_current"/>
                                <field name="delivery_proposed"/>
                                <field name="delivery_impact" 
                                       widget="badge"
                                       decoration-success="delivery_impact == 'earlier'"
                                       decoration-info="delivery_impact == 'new'"
                                       decoration-danger="delivery_impact == 'later'"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                
                <footer>
                    <button name="action_create_shipment" 
                            type="object" 
                            string="Create Shipment" 
                            class="btn-primary"
                            invisible="has_hard_errors"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>
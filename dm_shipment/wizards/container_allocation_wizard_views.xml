<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_container_allocation_wizard_form" model="ir.ui.view">
        <field name="name">container.allocation.wizard.form</field>
        <field name="model">container.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Plan Containers">
                
                <group name="shipment">
                    <field name="shipment_id" readonly="1"/>
                    <field name="allocation_mode"/>
                </group>
                
                <separator string="Shipment Requirements Analysis"/>
                <group>
                    <group name="quantities">
                        <field name="total_packages"/>
                        <field name="total_weight"/>
                        <field name="total_volume"/>
                    </group>
					<group name="reefer">
                        <field name="requires_reefer"/>
                        <field name="min_temp_required" 
                               invisible="not requires_reefer"/>
                        <field name="max_temp_required" 
                               invisible="not requires_reefer"/>
                        <field name="min_humidity_required" 
                               invisible="not requires_reefer"/>
                        <field name="max_humidity_required" 
                               invisible="not requires_reefer"/>
                    </group>
                </group>
                
				<separator string="Suggested Configuration"/>
                <field name="suggested_config" 
                       widget="text" 
                       readonly="1" 
                       nolabel="1"/>
                
                <separator string="Deal-by-Deal Analysis"/>
                <field name="utilization_summary" 
                       widget="html" 
                       readonly="1" 
                       nolabel="1"/>
				
                <footer>
                    <button name="action_create_containers_auto" 
                            type="object" 
                            string="Create Containers" 
                            class="btn-primary"
                            invisible="allocation_mode != 'auto'"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_server_allocate_to_shipment" model="ir.actions.server">
        <field name="name">Allocate to Shipment</field>
        <field name="model_id" ref="dm_deal.model_dm_deal"/>
        <field name="binding_model_id" ref="dm_deal.model_dm_deal"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Allocate to Shipment',
        'res_model': 'dm.shipment.allocation.wizard',
        'view_mode': 'form',
        'target': 'new',
        'context': {'default_deal_ids': [(6, 0, records.ids)]},
    }
        </field>
    </record>
    <record id="seq_dm_shipment" model="ir.sequence">
        <field name="name">Shipment Sequence</field>
        <field name="code">dm.shipment</field>
        <field name="prefix">SHP</field>
        <field name="padding">5</field>
    </record>
</odoo>
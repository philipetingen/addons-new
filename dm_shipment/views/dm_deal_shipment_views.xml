<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Deal Form View - Shipment Extensions -->
    <!-- ============================================================ -->
    <record id="view_dm_deal_form_shipment" model="ir.ui.view">
        <field name="name">dm.deal.form.shipment</field>
        <field name="model">dm.deal</field>
        <field name="inherit_id" ref="dm_deal.view_dm_deal_form"/>
        <field name="arch" type="xml">
            
            <!-- Add shipment allocation status badge after allocation_status -->
            <field name="allocation_status" position="after">
                <field name="shipment_allocated" invisible="1"/>
                <field name="shipment_allocation_status" 
                       widget="badge"
                       decoration-success="shipment_allocation_status == 'allocated'"
                       decoration-warning="shipment_allocation_status == 'partial'"
                       decoration-muted="shipment_allocation_status == 'not_allocated'"/>
            </field>
            
            <!-- Add shipment smart button -->
            <div name="button_box" position="inside">
                <button name="action_view_shipments" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-ship" 
                        invisible="shipment_count == 0">
                    <field name="shipment_count" widget="statinfo" string="Shipments"/>
                </button>
            </div>
            
            <!-- DEPRECATED: Old allocation button with warning -->
            <header position="inside">
                <button name="action_allocate_to_shipment" 
                        string="⚠️ Allocate to Shipment (Old)"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ['confirmed', 'allocated', 'ready']"
                        help="DEPRECATED: Use Production Run allocation instead"/>
            </header>
            
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- Deal Tree View - Shipment Status Column -->
    <!-- ============================================================ -->
    <record id="view_dm_deal_tree_shipment" model="ir.ui.view">
        <field name="name">dm.deal.tree.shipment</field>
        <field name="model">dm.deal</field>
        <field name="inherit_id" ref="dm_deal.view_dm_deal_tree"/>
        <field name="arch" type="xml">
            
            <!-- Add shipment allocation status column -->
            <field name="state" position="before">
                <field name="shipment_allocated" 
                       widget="boolean_toggle" 
                       optional="hide"/>
                <field name="shipment_allocation_status" 
                       widget="badge" 
                       optional="hide"
                       decoration-success="shipment_allocation_status == 'allocated'"
                       decoration-warning="shipment_allocation_status == 'partial'"
                       decoration-muted="shipment_allocation_status == 'not_allocated'"/>
            </field>
            
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- Deal Search View - Shipment Filters -->
    <!-- ============================================================ -->
    <record id="view_dm_deal_search_shipment" model="ir.ui.view">
        <field name="name">dm.deal.search.shipment</field>
        <field name="model">dm.deal</field>
        <field name="inherit_id" ref="dm_deal.view_dm_deal_search"/>
        <field name="arch" type="xml">
            
            <!-- Add shipment allocation filters -->
            <!-- Use xpath to find any filter and add after it -->
            <xpath expr="//filter[last()]" position="after">
                <separator/>
                <filter string="Not Allocated to Shipment" 
                        name="filter_not_allocated_shipment"
                        domain="[('shipment_allocated', '=', False)]"/>
                <filter string="Allocated to Shipment" 
                        name="filter_allocated_shipment"
                        domain="[('shipment_allocated', '=', True)]"/>
                <filter string="Ready + Not Shipped" 
                        name="filter_ready_not_shipped"
                        domain="[('state', '=', 'ready'), ('shipment_allocated', '=', False)]"/>
            </xpath>
            
        </field>
    </record>
</odoo>
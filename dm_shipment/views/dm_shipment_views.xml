<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Shipment Tree View -->
    <!-- ============================================================ -->
    <record id="view_dm_shipment_tree" model="ir.ui.view">
        <field name="name">dm.shipment.tree</field>
        <field name="model">dm.shipment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="loading_port_id"/>
                <field name="discharge_port_id"/>
                <field name="loading_date" optional="show"/>
                <field name="etd"/>
                <field name="eta"/>
                <!-- Phase 5 Sprint 1: PR count -->
                <field name="production_run_count" optional="show"/>
                <field name="deal_count"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- Shipment Form View -->
    <!-- ============================================================ -->
    <record id="view_dm_shipment_form" model="ir.ui.view">
        <field name="name">dm.shipment.form</field>
        <field name="model">dm.shipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" 
                            string="Confirm" 
                            type="object" 
                            invisible="state != 'draft'" 
                            class="btn-primary"/>
                    <button name="action_start_loading" 
                            string="Start Loading" 
                            type="object" 
                            invisible="state != 'confirmed'" 
                            class="btn-primary"/>
                    <button name="action_ship" 
                            string="Ship" 
                            type="object" 
                            invisible="state not in ['confirmed','loading']" 
                            class="btn-primary"/>
                    <button name="action_arrive" 
                            string="Mark Arrived" 
                            type="object" 
                            invisible="state != 'shipped'" 
                            class="btn-primary"/>
                    <button name="action_deliver" 
                            string="Deliver" 
                            type="object" 
                            invisible="state not in ['shipped','arrived']" 
                            class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box">
                        <!-- Phase 5 Sprint 1: Production Runs Smart Button -->
                        <button name="action_view_production_runs"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-industry"
                                invisible="production_run_count == 0">
                            <field name="production_run_count" widget="statinfo" string="Production Runs"/>
                        </button>
                        
                        <button name="action_view_deals" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o" 
                                invisible="deal_count == 0">
                            <field name="deal_count" widget="statinfo" string="Deals"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    
                    <group>
                        <group string="Route">
                            <field name="loading_port_id"/>
                            <field name="discharge_port_id"/>
                        </group>
                        <group string="Schedule">
                            <field name="loading_date"/>
                            <field name="etd"/>
                            <field name="eta"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Phase 5 Sprint 1: Production Runs Tab -->
                        <page string="Production Runs" name="production_runs">
                            <field name="production_run_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="supplier_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="rts_current"/>
                                    <field name="total_teu"/>
                                    <field name="total_containers"/>
                                </tree>
                            </field>
                        </page>
                        
                        <!-- Phase 5 Sprint 1: Deals (via PRs) Tab -->
                        <page string="Deals (via PRs)" name="deals_from_prs">
                            <field name="deal_ids_from_prs" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="customer_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="total_teu"/>
                                    <field name="total_containers"/>
                                </tree>
                            </field>
                        </page>
                        
                        <!-- Old Deals Tab (backward compatibility) -->
                        <page string="Deals (Direct)" name="deals" invisible="1">
                            <field name="deal_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="customer_id"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- Shipment Search View -->
    <!-- ============================================================ -->
    <record id="view_dm_shipment_search" model="ir.ui.view">
        <field name="name">dm.shipment.search</field>
        <field name="model">dm.shipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="loading_port_id"/>
                <field name="discharge_port_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Loading" name="filter_loading" domain="[('state', '=', 'loading')]"/>
                <filter string="Shipped" name="filter_shipped" domain="[('state', '=', 'shipped')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Loading Port" name="group_loading_port" context="{'group_by': 'loading_port_id'}"/>
                    <filter string="Discharge Port" name="group_discharge_port" context="{'group_by': 'discharge_port_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- Shipment Action -->
    <!-- ============================================================ -->
    <record id="action_dm_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">dm.shipment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Shipment
            </p>
            <p>
                Shipments consolidate production runs for logistics coordination.
            </p>
        </field>
    </record>
    
    <menuitem id="menu_dm_shipment_root" name="Shipment" sequence="40"/>
    <menuitem id="menu_dm_shipments" name="Shipments" parent="menu_dm_shipment_root" action="action_dm_shipment"/>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Extend Subdeal Form - Add milestone locking for milestones 3-6 -->
    <record id="view_dm_deal_subdeal_form_shipment_milestone_lock" model="ir.ui.view">
        <field name="name">dm.deal.subdeal.form.shipment.milestone.lock</field>
        <field name="model">dm.deal.subdeal</field>
        <field name="inherit_id" ref="dm_deal.view_dm_deal_subdeal_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            
            <!-- Add hidden field for lock state -->
            <xpath expr="//page[@name='milestones']" position="before">
                <field name="milestones_locked" invisible="1"/>
            </xpath>
            
            <!-- Add lock banner at top of milestones page -->
            <xpath expr="//page[@name='milestones']/group[1]" position="before">
                <div class="alert alert-info" role="alert" 
                     invisible="not milestones_locked"
                     style="margin: 16px;">
                    <p class="mb-0">
                        <i class="fa fa-lock"/> <strong>Milestones Locked:</strong> 
                        Loading, ETD, ETA, and Delivery dates are controlled by the shipment.
                    </p>
                </div>
            </xpath>
            
            <!-- MILESTONE 3: LOADING - Add lock -->
            <xpath expr="//page[@name='milestones']//field[@name='loading_requested']" position="attributes">
                <attribute name="readonly">milestones_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='milestones']//field[@name='loading_current']" position="attributes">
                <attribute name="readonly">milestones_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='milestones']//field[@name='loading_actual']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            
            <!-- MILESTONE 4: ETD - Add lock -->
            <xpath expr="//page[@name='milestones']//field[@name='etd_requested']" position="attributes">
                <attribute name="readonly">milestones_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='milestones']//field[@name='etd_current']" position="attributes">
                <attribute name="readonly">milestones_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='milestones']//field[@name='etd_actual']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            
            <!-- MILESTONE 5: ETA - Add lock -->
            <xpath expr="//page[@name='milestones']//field[@name='eta_requested']" position="attributes">
                <attribute name="readonly">milestones_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='milestones']//field[@name='eta_current']" position="attributes">
                <attribute name="readonly">milestones_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='milestones']//field[@name='eta_actual']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            
            <!-- MILESTONE 6: DELIVERY - Add lock -->
            <xpath expr="//page[@name='milestones']//field[@name='delivery_requested']" position="attributes">
                <attribute name="readonly">milestones_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='milestones']//field[@name='delivery_current']" position="attributes">
                <attribute name="readonly">milestones_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='milestones']//field[@name='delivery_actual']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            
        </field>
    </record>
    
</odoo>
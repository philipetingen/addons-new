<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Shipment Form View - WITH MILESTONES -->
    <record id="view_dm_shipment_form" model="ir.ui.view">
        <field name="name">dm.shipment.form</field>
        <field name="model">dm.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <!-- Draft → Confirmed -->
                    <button name="action_confirm" 
                            type="object" 
                            string="Confirm"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>
                    
                    <!-- Confirmed → Loading -->
                    <button name="action_start_loading" 
                            type="object" 
                            string="Start Loading"
                            invisible="state != 'confirmed'"
                            class="oe_highlight"/>
                    
                    <!-- Loading Wizard -->
                    <button name="action_open_loading_wizard" 
                            string="Confirm Loading" 
                            type="object" 
                            invisible="state != 'loading'"
                            class="oe_highlight"/>
                    
                    <!-- Loaded → Departed -->
                    <button name="action_mark_departed" 
                            type="object" 
                            string="Mark Departed"
                            invisible="state != 'loaded'"
                            class="oe_highlight"/>
                    
                    <!-- Departed → Arrived -->
                    <button name="action_mark_arrived" 
                            type="object" 
                            string="Mark Arrived"
                            invisible="state != 'departed'"
                            class="oe_highlight"/>
                    
                    <!-- Arrived → Delivered -->
                    <button name="action_mark_delivered" 
                            type="object" 
                            string="Mark Delivered"
                            invisible="state != 'arrived'"
                            class="oe_highlight"/>
                    
                    <!-- Back to Draft -->
                    <button name="action_set_to_draft" 
                            type="object" 
                            string="Set to Draft"
                            invisible="state not in ['confirmed', 'cancelled']"/>
                    
                    <!-- Cancel -->
                    <button name="action_cancel" 
                            type="object" 
                            string="Cancel"
                            invisible="state in ['draft', 'cancelled', 'delivered']"
                            confirm="This will deallocate all deals. Continue?"/>
                    
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,loading,loaded,departed,arrived,delivered"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_deals" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-cubes">
                            <field name="deal_count" widget="statinfo" string="Deals"/>
                        </button>
                        
                        <button name="action_view_containers" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-archive">
                            <field name="container_count" widget="statinfo" string="Containers"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="route" string="Route">
                            <field name="supplier_id"/>
                            <field name="loading_port_id"/>
                            <field name="discharge_port_id"/>
                        </group>
                        
						<group name="parties" string="Parties">
							<field name="customer_ids" widget="many2many_tags" readonly="1"/>
						</group>						
						
                        <group name="summary" string="Summary">
                            <field name="total_teu"/>
                            <field name="subdeal_count" string="Sub-Deals"/>
							<field name="product_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    
					<notebook>
                        <!-- Milestones Page -->
                        <page string="Milestones" name="milestones">
                            <group>
                                <group string="Planned Dates">
                                    <field name="loading_current"/>
                                    <field name="etd_current"/>
                                    <field name="eta_current"/>
                                    <field name="delivery_current"/>
                                </group>
                                <group string="Actual Dates">
                                    <field name="loading_actual"/>
                                    <field name="etd_actual"/>
                                    <field name="eta_actual"/>
                                    <field name="delivery_actual"/>
                                </group>
                            </group>
                            
                            <!-- Reschedule button (Sprint F placeholder) -->
                            <div class="mt-3" invisible="state in ['delivered', 'cancelled']">
                                <button name="action_reschedule" 
                                        type="object" 
                                        string="Reschedule Milestones"
                                        class="btn-secondary"
                                        icon="fa-calendar"/>
                            </div>
                        </page>
                        
                        <!-- Deals Page - Full tree view -->
                        <page string="Deals" name="deals">
                            <field name="customer_po_numbers" invisible="1"/>
                            <field name="product_names" invisible="1"/>
                            <field name="deal_ids" nolabel="1" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="customer_id"/>
                                    <field name="product_ids" widget="many2many_tags"/>
                                    <field name="customer_po_number"/>
                                    <field name="po_date"/>
                                    <field name="rts_current"/>
                                    <field name="eta_current"/>
                                    <field name="amount_untaxed_sale" string="Total Sale"/>
                                    <field name="margin_percent" widget="percentage"/>
                                    <field name="total_containers"/>
                                    <field name="total_teu"/>
                                    <field name="production_status" widget="badge"
                                           decoration-success="production_status == 'complete'"
                                           decoration-info="production_status == 'in_progress'"
                                           decoration-warning="production_status == 'not_planned'"
                                           optional="show"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        
                        <!-- Containers Page -->
                        <page string="Containers" name="containers">
                            <button name="action_plan_containers" 
                                    type="object" 
                                    string="Plan Containers" 
                                    class="oe_highlight"
                                    invisible="container_count &gt; 0 or state not in ('draft', 'confirmed')"/>
                            
                            <field name="container_ids">
                                <tree decoration-danger="is_over_capacity == True">
                                    <field name="sequence" widget="handle"/>
                                    <field name="container_number"/>
                                    <field name="container_type_id"/>
                                    <field name="planned_packages"/>
                                    <field name="actual_packages"/>
                                    <field name="utilization_weight" widget="percentage"/>
                                    <field name="utilization_volume" widget="percentage"/>
                                    <field name="container_teu"/>
                                    <field name="is_over_capacity" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        
                        <!-- Route Details Page - Placeholder for future -->
                        <page string="Route Details" name="route_details">
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle"/> Route details and journey legs will be managed here in a future release.
                            </div>
                            <group>
                                <group string="Ports">
                                    <field name="loading_port_id" readonly="1"/>
                                    <field name="discharge_port_id" readonly="1"/>
                                </group>
                                <group string="Carrier (Future)">
                                    <!-- Placeholder for shipping line, vessel, voyage -->
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Shipment Tree View - WITH MILESTONE DATES -->
    <record id="view_dm_shipment_tree" model="ir.ui.view">
        <field name="name">dm.shipment.tree</field>
        <field name="model">dm.shipment</field>
        <field name="arch" type="xml">
            <tree string="Shipments">
                <field name="name"/>
                <field name="supplier_id"/>
				<field name="customer_ids" widget="many2many_tags" optional="show"/>
				<field name="product_ids" widget="many2many_tags" optional="show"/>				
                <field name="loading_port_id"/>
                <field name="discharge_port_id"/>
                <field name="loading_current" optional="show"/>
                <field name="etd_current" optional="show"/>
                <field name="eta_current" optional="show"/>
                <field name="deal_count"/>
                <field name="container_count"/>
                <field name="total_teu"/>
                <field name="customer_po_numbers" optional="hide"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'delivered'"
                       decoration-info="state in ['confirmed', 'loading', 'loaded']"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>
    
    <!-- Shipment Search View - WITH MILESTONE FILTERS -->
    <record id="view_dm_shipment_search" model="ir.ui.view">
        <field name="name">dm.shipment.search</field>
        <field name="model">dm.shipment</field>
        <field name="arch" type="xml">
            <search string="Search Shipments">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="loading_port_id"/>
                <field name="discharge_port_id"/>
                <field name="customer_po_numbers"/>
                
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress" 
                        domain="[('state', 'in', ['loading', 'loaded', 'departed'])]"/>
                <filter string="Delivered" name="delivered" domain="[('state', '=', 'delivered')]"/>
                
                <separator/>
                
                <filter string="Loading This Week" name="loading_this_week" 
                        domain="[('loading_current', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                                 ('loading_current', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="ETD This Month" name="etd_this_month" 
                        domain="[('etd_current', '&gt;=', time.strftime('%Y-%m-01')),
                                 ('etd_current', '&lt;', (datetime.datetime.now() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Supplier" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Loading Port" name="group_pol" context="{'group_by': 'loading_port_id'}"/>
                    <filter string="Loading Date" name="group_loading" context="{'group_by': 'loading_current:month'}"/>
                    <filter string="ETD" name="group_etd" context="{'group_by': 'etd_current:month'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action: All Shipments -->
    <record id="action_dm_shipment_all" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">dm.shipment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first shipment
            </p>
            <p>
                Shipments consolidate multiple deals for container loading and logistics tracking.
            </p>
        </field>
    </record>
    
</odoo>
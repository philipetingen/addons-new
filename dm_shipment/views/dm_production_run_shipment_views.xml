<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Production Run Tree View - Shipment Extensions -->
    <!-- ============================================================ -->
    <record id="view_dm_production_run_tree_shipment" model="ir.ui.view">
        <field name="name">dm.production.run.tree.shipment</field>
        <field name="model">dm.production.run</field>
        <field name="inherit_id" ref="dm_production.view_dm_production_run_tree"/>
        <field name="arch" type="xml">
            
            <!-- Add shipment allocation columns before state -->
            <field name="state" position="before">
                <field name="shipment_allocated" widget="boolean_toggle" optional="show"/>
                <field name="shipment_allocation_status" 
                       widget="badge" 
                       optional="show"
                       decoration-success="shipment_allocation_status == 'allocated'"
                       decoration-warning="shipment_allocation_status == 'partial'"
                       decoration-muted="shipment_allocation_status == 'not_allocated'"/>
            </field>
            
        </field>
    </record>

	<!-- ============================================================ -->
    <!-- Production Run Form View - Shipment Extensions -->
    <!-- ============================================================ -->
    <record id="view_dm_production_run_form_shipment" model="ir.ui.view">
        <field name="name">dm.production.run.form.shipment</field>
        <field name="model">dm.production.run</field>
        <field name="inherit_id" ref="dm_production.view_dm_production_run_form"/>
        <field name="arch" type="xml">
            
            <!-- Add shipment allocation button in header -->
            <button name="action_complete" position="after">
                <button name="action_allocate_to_shipment"
                        string="Allocate to Shipment"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ['ready', 'completed']"
                        help="Allocate this production run to a shipment"/>
            </button>
            
            <!-- Add shipment smart button -->
            <div name="button_box" position="inside">
                <button name="action_view_shipments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-ship"
                        invisible="shipment_count == 0">
                    <field name="shipment_count" widget="statinfo" string="Shipments"/>
                </button>
            </div>
            
            <!-- Add allocation status after company_id field -->
            <field name="company_id" position="after">
                <field name="shipment_allocated" widget="boolean_toggle"/>
                <field name="shipment_allocation_status" 
                       widget="badge"
                       decoration-success="shipment_allocation_status == 'allocated'"
                       decoration-warning="shipment_allocation_status == 'partial'"
                       decoration-muted="shipment_allocation_status == 'not_allocated'"/>
            </field>
            
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- Production Run Search View - Shipment Filters -->
    <!-- ============================================================ -->
    <record id="view_dm_production_run_search_shipment" model="ir.ui.view">
        <field name="name">dm.production.run.search.shipment</field>
        <field name="model">dm.production.run</field>
        <field name="inherit_id" ref="dm_production.view_dm_production_run_search"/>
        <field name="arch" type="xml">
            
            <!-- Add shipment filters -->
            <xpath expr="//filter[@name='ready']" position="after">
                <separator/>
                <filter string="Not Allocated to Shipment" 
                        name="filter_not_allocated_shipment"
                        domain="[('shipment_allocated', '=', False)]"/>
                <filter string="Allocated to Shipment" 
                        name="filter_allocated_shipment"
                        domain="[('shipment_allocated', '=', True)]"/>
                <separator/>
                <filter string="Ready for Shipment" 
                        name="filter_ready_for_shipment"
                        domain="[('state', '=', 'ready'), ('shipment_allocated', '=', False)]"/>
            </xpath>
            
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- Bulk Allocation Server Action -->
    <!-- ============================================================ -->
    <record id="action_allocate_prs_to_shipment_bulk" model="ir.actions.server">
        <field name="name">Allocate to Shipment</field>
        <field name="model_id" ref="dm_production.model_dm_production_run"/>
        <field name="binding_model_id" ref="dm_production.model_dm_production_run"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Allocate to Shipment',
        'res_model': 'dm.shipment.allocation.wizard',
        'view_mode': 'form',
        'target': 'new',
        'context': {
            'default_production_run_ids': [(6, 0, records.ids)],
            'default_shipment_mode': 'new',
        },
    }
        </field>
    </record>
</odoo>